#    PlayerbotsPlus.Companions.Enable
#    PlayerbotsPlus.Companions.OwnChance
#    PlayerbotsPlus.Companions.CollectorChance
#    PlayerbotsPlus.Companions.CommonWeight
#        A random bot near a real player, out in the world, may own some of
#        the companions below: OwnChance of them do, the same ones every
#        session. Most own a common one or two (weight CommonWeight or more:
#        the pet sellers' wares), and CollectorChance of the owners collect
#        them, the rare ones too, more as they level: two at first, up to
#        six by 78. Only ever what its side can have and what is had at its
#        level. A companion is learned the way its item teaches it, and out
#        of earshot of everyone real: a first companion earns Can I Keep
#        Him?, which the game tells everyone in /say range -- and the bot's
#        guild, so a bot with none yet also waits while anyone real is
#        online in its guild. Bots nobody sees get nothing.
#        Default: 1, 70, 15, 4
PlayerbotsPlus.Companions.Enable = 1
PlayerbotsPlus.Companions.OwnChance = 70
PlayerbotsPlus.Companions.CollectorChance = 15
PlayerbotsPlus.Companions.CommonWeight = 4

#    PlayerbotsPlus.Companions.OutChance
#    PlayerbotsPlus.Companions.SwitchChance
#    PlayerbotsPlus.Companions.HolidayBoost
#        About OutChance of the bots near you have a companion out (of those
#        that own one, OutChance / OwnChance: 43% with the defaults). It is
#        decided again every 20 to 40 minutes, and one that is not to have it
#        out any more puts it away. A bot only ever has out one it could have
#        at its level. Once in each stretch with nothing on (hanging out, or
#        idle in playerbots' own terms), SwitchChance of those with one out
#        swap it for another they own, a minute to five in. A holiday's own
#        companions (the :holiday ones below) come out HolidayBoost times as
#        often as the others while it is on, and a quarter as often when it
#        is not; and while it is on, about half of the bots that own any
#        have picked one of them up.
#        Default: 30, 33, 8
PlayerbotsPlus.Companions.OutChance = 30
PlayerbotsPlus.Companions.SwitchChance = 33
PlayerbotsPlus.Companions.HolidayBoost = 8

#    PlayerbotsPlus.Companions.CheckSeconds
#    PlayerbotsPlus.Companions.Range
#        Bots within Range yards of a real player are looked at every
#        CheckSeconds: on foot or mounted, not in a fight, not sat down. Never
#        in a dungeon, raid, battleground or arena.
#        Default: 10, 80
PlayerbotsPlus.Companions.CheckSeconds = 10
PlayerbotsPlus.Companions.Range = 80

#    PlayerbotsPlus.Companions.Alliance
#    PlayerbotsPlus.Companions.Horde
#    PlayerbotsPlus.Companions.Both
#        The companions, by who can get them, separated by |: the item that
#        teaches one, then a minimum level, a weight and a holiday,
#        "item:level:weight:holiday" (level 1 and weight 10 when left out;
#        no holiday). The level is where it is had: the pet sellers' wares at
#        10 (a few silver to spare), Booty Bay's parrots at 30, the
#        Stormspire's at 65, Dalaran's pet shop at 70, a drop where it drops
#        (the Deadmines' macaw at 18, the Wetlands' whelps at 22,
#        Winterspring's at 55), the Argent Tournament's at 80. The weight is
#        how common it is: 8-10 the pet sellers' wares, 4 the easy ones, 1-3
#        the rare ones, the holidays' and the promotional ones. The holiday
#        is the one it comes from: winterveil, hallowsend, midsummer,
#        loveisintheair, noblegarden, childrensweek, brewfest,
#        pilgrimsbounty, lunarfestival or darkmoon (the Faire). An item that
#        is not a companion's is left out, and the server log says how many.
PlayerbotsPlus.Companions.Alliance = "8485:10|8486:10|8487:10|8488:10|8489:10:8|8497:8:8|8500:10:8|8501:10:8|29901:10:8|29903:10:8|29904:10:8|49662:1:1|44998:80:2|44965:80:2|44970:80:2|44974:80:2|44984:80:2|45002:80:2|46820:80:1"
PlayerbotsPlus.Companions.Horde = "10360:10|10361:10|10392:10|10393:10:8|10394:10:8|29953:10:8|29956:10:8|29957:10:8|49663:1:1|45022:80:2|44971:80:2|44973:80:2|44980:80:2|44982:80:2|45606:80:2|46821:80:1"
PlayerbotsPlus.Companions.Both = "11026:10:4:darkmoon|11027:10:4:darkmoon|11110:12:2|11023:25:4|8495:30:4|8496:30:4|8490:65:4|29363:65:4|29364:65:4|29902:65:4|29958:65:4|44822:70:4|46398:70:4|48120:70:3|39973:70:2|54436:70:2|4401:15:2|11825:41:1|11826:41:1|15996:53:1|21277:55:1|48114:17:1|8492:18:2|48118:18:1|8499:22:2|10822:25:2|8491:25:2|48124:28:1|48112:35:1|8494:40:1|18964:40:1|10398:45:2|11474:45:2|8498:45:2|19450:45:2:darkmoon|48122:50:1|20769:50:2|34535:55:2|48126:60:1|29960:62:2|34478:64:1|27445:65:1|33816:70:1|33818:70:1|38628:70:1|35504:70:1|33993:70:1|38658:70:1|35349:74:1|35350:74:1|43698:74:1|44983:74:2|44723:74:1|44738:75:1|39896:76:1|39899:76:1|39898:76:1|44721:76:1|48116:76:1|49912:15:1|23002:10:2:childrensweek|23007:10:2:childrensweek|23015:10:2:childrensweek|32616:60:1:childrensweek|32617:60:1:childrensweek|32622:60:1:childrensweek|46544:70:1:childrensweek|46545:70:1:childrensweek|21301:10:2:winterveil|21305:10:2:winterveil|21308:10:2:winterveil|21309:10:2:winterveil|34425:10:1:winterveil|33154:10:2:hallowsend|23083:10:1:midsummer|34955:10:2:midsummer|53641:75:1:midsummer|22235:10:2:loveisintheair|50446:78:1:loveisintheair|44794:10:2:noblegarden|44810:10:2:pilgrimsbounty|32233:10:2:brewfest|46707:10:1:brewfest|49665:1:1|49693:1:1|54847:1:1|13582:1:1|13583:1:1|13584:1:1|25535:1:1|39286:1:1|49343:1:1"

###############################################################################
#
#   DUELS AT THE CITY GATES
#
#   On a real realm people duel in one place: just outside the main gate of
#   Orgrimmar or Stormwind, a crowd standing about, a pair or two going at it
#   at a time, the rest watching and waiting for a go. Not out in the world.
#   Playerbots only starts a duel through its old RPG strategy, which a realm
#   on the new one (Playerbots.EnableNewRpgStrategy = 1) never runs, so bots
#   never did.
#
#   Each spot in Duels.Spots is a city hangout outside a gate (see CITY
#   HANGOUTS: OrgrimmarGates and StormwindGates), and it fills with bots like
#   the others -- also from just inside the city, and the ones fetched from
#   elsewhere while someone is about arrive at the city's inn and walk out
#   through the gate. While a real player is within WatchRange of one, two of
#   the crowd there of the same side and about the same level duel now and
#   then: one walks over and challenges the other the way the Duel button
#   does, and playerbots accepts and fights it out. With mod-ollama-chat they
#   say so ("gg") the way it does for any duel. Then both get their breath
#   back (eating or drinking if they like) and go back to their places for
#   the rest of their time there. Nowhere else does a bot start a duel.
#
#   A spot has to be somewhere the game allows duels, which is not inside a
#   city: one that is not is said in the log and left alone.
#
#   With mod-ollama-chat, two bots chatting in the city may also talk
#   themselves into a duel -- only two of a side, of MinLevel or more and
#   within LevelGap of each other, near enough to walk out to a spot (as far
#   as one outside the gates takes its crowd from, Hangout.ArrivalRange) are
#   ever offered it. When they have said their piece both walk out to the
#   spot, and once both are there one challenges the other as soon as the
#   spot has room for another duel (MaxAtOnce), watched or not. If the crowd
#   there is at its room, two of it head off to make room for them.
#
###############################################################################

#    PlayerbotsPlus.Duels.Enable
#    PlayerbotsPlus.Duels.Spots
#        The hangout spots (PlayerbotsPlus.Hangout.Spot.<Name>) where people
#        duel, separated by |. To add one, add a hangout spot just outside a
#        gate and put its name here.
#        Default: 1, "OrgrimmarGates|StormwindGates"
PlayerbotsPlus.Duels.Enable = 1
PlayerbotsPlus.Duels.Spots = "OrgrimmarGates|StormwindGates"

#    PlayerbotsPlus.Duels.CheckSeconds
#    PlayerbotsPlus.Duels.Chance
#    PlayerbotsPlus.Duels.WatchRange
#    PlayerbotsPlus.Duels.MaxAtOnce
#        Every CheckSeconds, at each spot with a real player within WatchRange
#        yards of its middle, Chance of the time a duel starts, while fewer
#        than MaxAtOnce are going on there.
#        Default: 15, 60, 150, 2
PlayerbotsPlus.Duels.CheckSeconds = 15
PlayerbotsPlus.Duels.Chance = 60
PlayerbotsPlus.Duels.WatchRange = 150
PlayerbotsPlus.Duels.MaxAtOnce = 2

#    PlayerbotsPlus.Duels.LevelGap
#    PlayerbotsPlus.Duels.MinLevel
#    PlayerbotsPlus.Duels.BotCooldownMinutes
#        The two are no more than LevelGap levels apart and at least MinLevel,
#        with their health and mana up, and neither AFK. A bot does not
#        duel again for BotCooldownMinutes after a challenge.
#        Default: 5, 10, 4
PlayerbotsPlus.Duels.LevelGap = 5
PlayerbotsPlus.Duels.MinLevel = 10
PlayerbotsPlus.Duels.BotCooldownMinutes = 4

#    PlayerbotsPlus.Duels.ChallengePlayerChance
#    PlayerbotsPlus.Duels.ChallengePlayerMinutes
#        The chance, on a check that starts a duel, that one of the crowd of
#        your side and about your level challenges you instead, if you are
#        standing about at the spot (still, on foot, not AFK, health up), as
#        people at the gates do. Nobody is asked twice in
#        ChallengePlayerMinutes. 0 never.
#        Default: 0, 10
PlayerbotsPlus.Duels.ChallengePlayerChance = 0
PlayerbotsPlus.Duels.ChallengePlayerMinutes = 10

###############################################################################
#
#   MUTED BOT LINES
#
#   Playerbots whispers a stock line for a lot of what bots do: "Using
#   [Hearthstone]", "Drinking [Conjured Water] (40%)", "Equipping [Lorekeeper's
#   Ring]", "Opened item: Satchel of Helpful Goods", "AI was reset to
#   defaults", "I don't know this dungeon, lead the way!". The ones listed
#   here never reach you.
#
#   Only lines a bot sends as a whisper or in party or raid chat are looked
#   at, and only whole lines: "Staying" would mute that word alone, not
#   "staying here till you are back". A line another module sends for a bot
#   in its own words (mod-ollama-chat's) is never muted, so "Hi" on the list
#   mutes playerbots' stock "Hi" whisper on joining a group but never a
#   bot's own "hi". Playerbots' red error lines to a master ("Mungehdo: I
#   can't do this right now") are looked at too, by what comes after the
#   names, when every name in front is a bot's.
#
#   Patterns are separated by ; (an item link starts with |, so | cannot be
#   the separator here), compared ignoring case; * matches anything, so
#   "Using |c*" is "Using " followed by an item link.
#
#   With mod-ollama-chat, the bots say much of the rest in their own words:
#   "Staying" and "Following" to an order, hello in party when they join a
#   group, a quest objective done in party rather than every kill whispered.
#   Mute playerbots' stock lines for those too, with this list instead of the
#   default (it is the default and then: orders; dying; the hellos on
#   joining; quest progress, "Kobold Vermin 3/10 [Kobold Camp Cleanup]" being
#   "* */* |c*|Hquest:*"; goodbyes; trades; taxis; the red "I can't do this
#   right now" a bot sends when it tries to put on gear mid-fight; and the
#   whispers about quests as you take and hand them in -- "Quest Available:
#   [Call of Fire]", "Can't take [Call of Fire]", "Accepted [...]", a quest
#   handed in or dropped from a full log, "Quest shared". What a bot answers
#   when you ask it about its quests ("quests", "drop") is left alone, and so
#   is "Choose reward:", which waits for you to pick):
#
#PlayerbotsPlus.Mute.Patterns = "AI was reset to defaults;Using |c*;Drinking |c*;Eating |c*;Feasting |c*;Equipping |c*;Opened item: *;I don't know this dungeon, lead the way!;Staying;Following;Fleeing;Running away;Attacking;Releasing...;Meet me at the graveyard;Hello;Hello!;Hi;Hi!;Hello there!;* */* |c*|Hquest:*;Quest completed |c*;I have accepted |c*;Grinding;Moving away from group;Hello, I follow you!;Hello, lead the way!;Hi, lead the way!;Goodbye!;Bye bye!;See you later!;Fair trade;Off with you;A pleasure doing business with you;Thanks;I am ready for the next flight;I can't do this right now;Quest*|Hquest:*;Accepted *|Hquest:*;Already completed *|Hquest:*;Already on *|Hquest:*;Can't take *|Hquest:*;Bags are full *|Hquest:*;Cannot accept *|Hquest:*;Quest accepted;Quest shared;I have this quest;I can't take this quest;Failed timer for *"
#
###############################################################################

#    PlayerbotsPlus.Mute.Enable
#        Default: 1
PlayerbotsPlus.Mute.Enable = 1

#    PlayerbotsPlus.Mute.Patterns
#        Default: "AI was reset to defaults;Using |c*;Drinking |c*;Eating |c*;Feasting |c*;Equipping |c*;Opened item: *;I don't know this dungeon, lead the way!"
PlayerbotsPlus.Mute.Patterns = "AI was reset to defaults;Using |c*;Drinking |c*;Eating |c*;Feasting |c*;Equipping |c*;Opened item: *;I don't know this dungeon, lead the way!"
