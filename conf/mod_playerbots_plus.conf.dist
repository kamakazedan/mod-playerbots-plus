PlayerbotsPlus.Hangout.Spot.DalaranBank = "571 5958.1 617.3 650.6 18 14 outside the bank in Dalaran"
PlayerbotsPlus.Hangout.Spot.DalaranRuneweaver = "571 5796.9 646.1 647.4 20 16 Runeweaver Square in Dalaran"
PlayerbotsPlus.Hangout.Spot.DalaranFountain = "571 5704.2 615.7 646.8 16 12 the fountain in the Eventide in Dalaran"
