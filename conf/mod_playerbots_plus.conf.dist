PlayerbotsPlus.Hangout.Spot.OrgrimmarGateway = "1 1527.0 -4408.0 18.0 22 10 just inside the gates of Orgrimmar"
PlayerbotsPlus.Hangout.Spot.OrgrimmarDrag = "1 1768.0 -4320.9 6.6 16 8 the Drag in Orgrimmar"
PlayerbotsPlus.Hangout.Spot.OrgrimmarHonor = "1 2076.4 -4824.2 23.7 18 8 the Valley of Honor in Orgrimmar"
PlayerbotsPlus.Hangout.Spot.OrgrimmarGates = "1 1320.0 -4400.0 27.0 22 14 outside the gates of Orgrimmar"
PlayerbotsPlus.Hangout.Spot.OrgrimmarZeppelins = "1 1342.0 -4645.0 53.6 10 5 the zeppelin tower outside Orgrimmar"
PlayerbotsPlus.Hangout.Spot.UndercityTrade = "0 1584.1 240.3 -52.2 16 10 the Trade Quarter in the Undercity"
PlayerbotsPlus.Hangout.Spot.ThunderBluffMiddle = "1 -1277.4 124.8 131.3 30 16 the middle of Thunder Bluff"
PlayerbotsPlus.Hangout.Spot.ThunderBluffBank = "1 -1263.3 44.5 127.5 16 8 outside the bank in Thunder Bluff"
PlayerbotsPlus.Hangout.Spot.DarnassusBank = "1 9943.0 2497.7 1317.7 16 8 outside the bank in Darnassus"
PlayerbotsPlus.Hangout.Spot.ExodarHall = "530 -3965.7 -11653.6 -138.8 18 8 the main hall of the Exodar"
PlayerbotsPlus.Hangout.Spot.SilvermoonExchange = "530 9744.0 -7466.1 13.5 22 10 the Royal Exchange in Silvermoon"
