[worldserver]

###############################################################################
#
#   PLAYERBOTS PLUS
#
#   Random bots doing what real players do, without an LLM: trading on the
#   auction house, hanging out where players do in the cities, getting
#   unstuck, stepping out of fires, leaving each other room to stand,
#   getting back up after dying, using raid marks the way groups do, naming
#   their hunter pets, keeping companions and duelling at the city gates;
#   and the stock lines playerbots whispers that nobody needs, muted.
#   Works with mod-playerbots. mod-ollama-chat, when it is in the same build,
#   has the bots talk about all of it in their own words; without it, they
#   just do it.
#
#   GM commands:
#       .pbp status          what it is doing
#       .pbp economy [days]  the random bots' economy over the last days (7)
#       .pbp visit [name]    that bot (or the one selected) trades now
#       .pbp reload          re-read this file (.reload config does too)
#
###############################################################################

#    PlayerbotsPlus.Enable
#        The whole module. Switched off, bots it was holding (sat down at a
#        hangout, AFK, kept on foot) are let go at once, and nothing is muted.
#        Default: 1
PlayerbotsPlus.Enable = 1

#    PlayerbotsPlus.Debug
#        More of what the bots do, in the server log at INFO
#        (module.playerbotsplus): each one heading over to a hangout, settling
#        and leaving; a bot stepping out of a fire or out of someone's way; a
#        rogue's sap step by step; a dead bot released.
#        Default: 0
PlayerbotsPlus.Debug = 0

###############################################################################
#
#   THE AUCTION HOUSE
#
#   Random bots in a capital city go to the auction house now and then, like
#   players: they collect their auction mail, put up what they have no use
#   for, and buy an upgrade they can afford or what their profession uses.
#
#   The auctions are real ones under the bot's own name, in its faction's
#   auction house: a real player can buy them, and the bots buy real players'
#   auctions too. The money is real: the deposit, the house's cut, and the
#   sale paid by mail an hour later, as for anyone. A bot does not walk to the
#   auctioneer; standing anywhere in the city is enough.
#
#   What a bot sells is what playerbots itself would take to the auction house
#   rather than a vendor: anything of common (white) quality or better that is
#   not soulbound, not for its quests, not for its professions and not worth
#   wearing -- cloth, leather, herbs and ore it has no profession for, gear it
#   will never put on. One whole stack per auction.
#
#   What it asks, per one: a little under the cheapest one already up (any
#   seller's, the auction house bot's too); if there is none, what it is worth
#   (a multiple of the vendor price); never more than someone of the item's
#   level could sensibly pay, and never so little that a vendor would pay
#   more -- if the market is already that low, it keeps it for a vendor. If it
#   comes back unsold, the bot asks less next time, and after a couple of
#   tries gives up on it.
#
###############################################################################

#    PlayerbotsPlus.Market.Enable
#        Default: 1
PlayerbotsPlus.Market.Enable = 1

#    PlayerbotsPlus.Market.IntervalSeconds
#    PlayerbotsPlus.Market.VisitsPerInterval
#        Every IntervalSeconds, this many bots that are due go to the auction
#        house.
#        Default: 10 seconds, 1 bot
PlayerbotsPlus.Market.IntervalSeconds = 10
PlayerbotsPlus.Market.VisitsPerInterval = 1

#    PlayerbotsPlus.Market.VisitCooldownMinutes
#        After a visit, a bot goes again after a random time in this range
#        (minutes, min:max). A bot first seen in a city goes some time within
#        the max, so they do not all go at once.
#        Default: 40:120
PlayerbotsPlus.Market.VisitCooldownMinutes = 40:120

#    PlayerbotsPlus.Market.MinLevel
#        Bots below this level stay out of it.
#        Default: 10
PlayerbotsPlus.Market.MinLevel = 10

#    PlayerbotsPlus.Market.ExtraZoneOrAreaIds
#        Where bots trade besides the capitals (where the game rests you "in a
#        city"): zone or area ids, separated by commas. Neither of the default
#        two has an auction house; a bot there uses its faction's, as a player
#        would by flying over. Empty for capitals only.
#        3703 = Shattrath City, 4395 = Dalaran.
#        Default: 3703,4395
PlayerbotsPlus.Market.ExtraZoneOrAreaIds = 3703,4395

#    PlayerbotsPlus.Market.MaxItemChecksPerVisit
#        How many items a visit asks playerbots about (is it spare? is it an
#        upgrade?): each one is a little work for the server.
#        Default: 30
PlayerbotsPlus.Market.MaxItemChecksPerVisit = 30

#    PlayerbotsPlus.Market.CollectMail
#        Bots collect their auction mail when they go: what they sold, what
#        came back unsold, what they bought. Without it they cannot buy.
#        Default: 1
PlayerbotsPlus.Market.CollectMail = 1

#    PlayerbotsPlus.Market.EquipBought
#        A bot that bought an upgrade puts it on.
#        Default: 1
PlayerbotsPlus.Market.EquipBought = 1

#    PlayerbotsPlus.Market.LogTrades
#        Every visit that did something, and every sale, in the server log
#        (module.playerbotsplus, info).
#        Default: 0
PlayerbotsPlus.Market.LogTrades = 0

# --- selling -------------------------------------------------------------------

#    PlayerbotsPlus.Market.Sell.Enable
#        Default: 1
PlayerbotsPlus.Market.Sell.Enable = 1

#    PlayerbotsPlus.Market.Sell.MinQuality
#    PlayerbotsPlus.Market.Sell.MaxQuality
#        0 poor, 1 common, 2 uncommon, 3 rare, 4 epic, 5 legendary.
#        Default: 1 to 4
PlayerbotsPlus.Market.Sell.MinQuality = 1
PlayerbotsPlus.Market.Sell.MaxQuality = 4

#    PlayerbotsPlus.Market.Sell.MaxPerVisit
#    PlayerbotsPlus.Market.Sell.MaxAuctionsPerBot
#        How many stacks a bot puts up in one visit, and how many it has up at
#        once at most.
#        Default: 3, 8
PlayerbotsPlus.Market.Sell.MaxPerVisit = 3
PlayerbotsPlus.Market.Sell.MaxAuctionsPerBot = 8

#    PlayerbotsPlus.Market.Sell.MaxBotAuctionsPerHouse
#        All random bots together never have more than this many up in one
#        auction house.
#        Default: 2000
PlayerbotsPlus.Market.Sell.MaxBotAuctionsPerHouse = 2000

#    PlayerbotsPlus.Market.Sell.MaxRelists
#        Something that came back unsold more often than this is left for a
#        vendor.
#        Default: 2
PlayerbotsPlus.Market.Sell.MaxRelists = 2

#    PlayerbotsPlus.Market.Sell.DurationWeights
#        How often a bot picks 12, 24 and 48 hours.
#        Default: 20,40,40
PlayerbotsPlus.Market.Sell.DurationWeights = 20,40,40

#    PlayerbotsPlus.Market.Sell.MaxBuyoutGold
#        No bot auction has a buyout above this.
#        Default: 50000
PlayerbotsPlus.Market.Sell.MaxBuyoutGold = 50000

# --- buying ---------------------------------------------------------------------

#    PlayerbotsPlus.Market.Buy.Enable
#    PlayerbotsPlus.Market.Buy.Upgrades
#    PlayerbotsPlus.Market.Buy.Materials
#        Bots buy gear that playerbots rates an upgrade for them (weapons,
#        armour, bigger bags), and what their professions use to skill up.
#        Default: 1, 1, 1
PlayerbotsPlus.Market.Buy.Enable = 1
PlayerbotsPlus.Market.Buy.Upgrades = 1
PlayerbotsPlus.Market.Buy.Materials = 1

#    PlayerbotsPlus.Market.Buy.MaxPerVisit
#        Default: 2
PlayerbotsPlus.Market.Buy.MaxPerVisit = 2

#    PlayerbotsPlus.Market.Buy.MaxShareOfGoldPct
#        The most a bot spends on any one thing, as a share of its gold.
#        Default: 25
PlayerbotsPlus.Market.Buy.MaxShareOfGoldPct = 25

#    PlayerbotsPlus.Market.Buy.ReserveCopperPerLevel
#        Gold a bot never spends here, per level, for repairs and training.
#        Default: 2000 (20 silver a level: 16 gold at 80)
PlayerbotsPlus.Market.Buy.ReserveCopperPerLevel = 2000

#    PlayerbotsPlus.Market.Buy.UpgradeMinQuality
#        Default: 2 (uncommon)
PlayerbotsPlus.Market.Buy.UpgradeMinQuality = 2

#    PlayerbotsPlus.Market.Buy.UpgradeLevelWindow
#        Gear made for the bot's level or up to this many levels below it.
#        Default: 6
PlayerbotsPlus.Market.Buy.UpgradeLevelWindow = 6

#    PlayerbotsPlus.Market.Buy.MaterialsMaxPctOfValue
#        The most a bot pays per one for materials, as a percentage of what
#        they are worth (Market.Price.GoodsValuePct of the vendor price).
#        Default: 200
PlayerbotsPlus.Market.Buy.MaterialsMaxPctOfValue = 200

# --- prices -----------------------------------------------------------------------
#
#   All per one item. "Wealth" is how much gold someone of a level has to
#   spend: WealthBaseCopper * e^(level / WealthGrowthLevels) -- with the
#   defaults about 2g at 10, 17g at 30, 117g at 50, 300g at 60, 2000g at 80.

#    PlayerbotsPlus.Market.Price.GearValuePct
#        What gear (weapons, armour) is worth when nobody else has one up, as a
#        percentage of its vendor price, by quality: poor, common, uncommon,
#        rare, epic, legendary, heirloom.
#        Default: 100,250,500,1000,2500,4000,4000
PlayerbotsPlus.Market.Price.GearValuePct = 100,250,500,1000,2500,4000,4000

#    PlayerbotsPlus.Market.Price.GoodsValuePct
#        The same for everything else: cloth, herbs, ore, potions...
#        Default: 300
PlayerbotsPlus.Market.Price.GoodsValuePct = 300

#    PlayerbotsPlus.Market.Price.FloorPctOfVendor
#        Never listed for less than this percentage of the vendor price: the
#        house keeps 5% of a sale (15% in the neutral ones).
#        Default: 110
PlayerbotsPlus.Market.Price.FloorPctOfVendor = 110

#    PlayerbotsPlus.Market.Price.WealthBaseCopper
#    PlayerbotsPlus.Market.Price.WealthGrowthLevels
#        Default: 10000, 10.5
PlayerbotsPlus.Market.Price.WealthBaseCopper = 10000
PlayerbotsPlus.Market.Price.WealthGrowthLevels = 10.5

#    PlayerbotsPlus.Market.Price.GearCapPctOfWealth
#        One piece of gear never costs more than this share (percent) of the
#        wealth at its level, by quality as above. A bot buying an upgrade
#        pays no more than this at its own level.
#        Default: 2,5,20,50,120,300,300
PlayerbotsPlus.Market.Price.GearCapPctOfWealth = 2,5,20,50,120,300,300

#    PlayerbotsPlus.Market.Price.StackCapPctOfWealth
#        A full stack of anything else never costs more than this share.
#        Default: 20
PlayerbotsPlus.Market.Price.StackCapPctOfWealth = 20

#    PlayerbotsPlus.Market.Price.UndercutPct
#        How far under the cheapest one up a bot goes (percent, min:max).
#        Default: 1:5
PlayerbotsPlus.Market.Price.UndercutPct = 1:5

#    PlayerbotsPlus.Market.Price.RelistDiscountPct
#        Asked this much less (percent) for every time it came back unsold.
#        Default: 15
PlayerbotsPlus.Market.Price.RelistDiscountPct = 15

###############################################################################
#
#   THE ECONOMY LEDGER
#
#   What the random bots' economy does, day by day, so changes to it can be
#   judged by numbers: it changes nothing itself. .pbp economy [days] prints
#   it, from the console or SOAP as well as in game; each day's is also
#   written to the server log (module.playerbotsplus) once the day is over.
#
#     - Gold in: looted, quest rewards, auction house mail, the rest (selling
#       to vendors, other mail, trades). Gold out: auction house buys and
#       deposits, the rest (vendors, repairs, training). And what playerbots
#       gives or takes outside the game's own payments -- its top-up whenever
#       it refreshes a bot, a level reset -- found by setting what a bot has
#       against what the game paid it, at each look.
#     - The auction house: what bots list (gear, goods, other) and who buys it
#       -- the AH bot, a player, another bot -- what bots buy and from whom,
#       and what comes back unsold.
#     - What bots loot (herbs, ore, leather, cloth, meat and fish, gems, gear
#       by quality, junk...), how much of it from herbs, veins, chests and
#       fishing; what they make (crafted or conjured) and buy from vendors.
#     - Where the gear they put on came from: handed out by playerbots (at a
#       level-up or a refresh), looted, a quest reward, the auction house, a
#       vendor, made -- and its item level.
#     - What they use up: food and drink, potions, elixirs, flasks, bandages,
#       scrolls, oils and stones.
#     - Every CensusMinutes, a look at all of them: gold held, item level by
#       level band, professions (and how many have a gathering one), who is in
#       the dungeon queue, the trade goods they carry and what is in their
#       banks, and who has what up on the auction houses.
#
#   Only playerbots' random bots count, not anyone's own. Whose auctions are
#   the AH bot's is mod-ah-bot-plus's own setting, AuctionHouseBot.GUIDs.
#
#   Kept in the characters database, table playerbots_plus_ledger (one row
#   per day and figure), written every FlushMinutes and at shutdown.
#
###############################################################################

#    PlayerbotsPlus.Ledger.Enable
#        Default: 1
PlayerbotsPlus.Ledger.Enable = 1

#    PlayerbotsPlus.Ledger.FlushMinutes
#    PlayerbotsPlus.Ledger.CensusMinutes
#    PlayerbotsPlus.Ledger.KeepDays
#        How often the figures are written to the database (1-60 minutes: a
#        crash loses at most this much); how often all the bots are looked at
#        (5-1440 minutes; spread over a second or two, a slice a tick); and
#        how many days are kept (7-3650; older ones are let go at
#        startup).
#        Default: 10, 30, 90
PlayerbotsPlus.Ledger.FlushMinutes = 10
PlayerbotsPlus.Ledger.CensusMinutes = 30
PlayerbotsPlus.Ledger.KeepDays = 90

###############################################################################
#
#   BOT DUNGEONS (needs mod-dungeon-clear)
#
#   Random bots run dungeons with nobody playing among them, the way players
#   do: through the dungeon finder. Playerbots only ever queues a random bot
#   for a dungeon a player has queued for, and mod-dungeon-clear only starts
#   a clear when a player says so; with this on:
#
#     - Every CheckSeconds a party is picked -- a tank, a healer and three to
#       do the damage, of one side and a level for the dungeon, those holding
#       quests for it first, for a dungeon of the level band furthest under
#       its share of the runs (LevelBands) -- and each of them queues for it,
#       as a player queues. A player who queues for it then can be matched in,
#       which makes it a player's group, and what happens there is theirs, as
#       it is in any group. Playerbots never lets the dungeon finder put bots
#       together by themselves, so with nobody matched in after AloneMinutes
#       the five leave the queue, make a party (the tank leads) and queue as
#       one, which it lets be. Either way, the offer of a group is said yes to
#       for them straight away: playerbots turns one down for a bot that is
#       fighting.
#     - A group of bots the dungeon finder made, with no player in it (one
#       this queued, or one playerbots queued for a dungeon a player wanted),
#       is taken on in its dungeon: anyone left outside is brought in, the
#       wander-about strategies (grind, rpg) come off for the run, and
#       mod-dungeon-clear clears it. Silently: there is nobody in the group
#       to talk to.
#     - A member that dies lies where it fell until someone rezzes it, the
#       tank too (mod-dungeon-clear's PreventBotRelease, and its AI held here
#       as well), and a rez offered to it is taken straight away.
#       mod-dungeon-clear sends a healer over once the fight is done, and
#       calls the run off if nobody left can rez or the rez takes longer than
#       its DungeonClear.PostCombatRezTimeoutSecs.
#     - A living member stays in its dungeon until the run is over.
#       Playerbots teleports a random bot that levels up to somewhere for its
#       new level (Playerbots.AutoTeleportForLevel) -- a grouped one only if
#       it leads the group, which in a bot dungeon is the tank -- and a tank
#       out of its dungeon ends the clear. A teleport off the dungeon's map
#       is turned down for a member of a run (the level-up still resets the
#       tank's AI for a moment, as playerbots does before it teleports). That
#       goes for a GM's .tele or .summon on one too, until the run ends.
#     - A member releasing anyway, leaving the dungeon or logging out during
#       a clear goes to the log with how and where, and how everyone stood
#       when a run fails (each death and rez too, with Debug on).
#     - The run fails when the whole party dies with nobody to rez, when
#       nothing has moved forward for NoProgressMinutes (no kill, no pack
#       cleared, no fight going on, not getting closer to the next boss), when
#       it stays stuck on something for two minutes, or after MaxRunMinutes.
#     - Done, and the last boss looted (LootSeconds), or failed: everyone is
#       brought back to life, leaves the group -- which takes them back where
#       they queued from -- and is unbound from the dungeon, with their usual
#       strategies back. They keep what they looted. They queue again after
#       CooldownMinutes (FailCooldownMinutes after a failure); a dungeon whose
#       runs fail AvoidAfterFailures times in a row is not gone to for
#       AvoidMinutes.
#     - A bot that logs in inside a dungeon it is no longer grouped for (the
#       server went down mid-run) is sent back out after a minute.
#
#   Dungeon quests (Quests = 1). Playerbots' own questing only takes quests
#   one can do alone, and clears out a full quest log starting with the ones
#   it cannot. So:
#
#     - idle bots walk (playerbots' own "go camp" walk) to the givers of normal
#       dungeon quests on the continent they are on, within QuestRange, and
#       take the ones that suit them: of their level, not grey, for a dungeon
#       they have not outgrown, and that the game lets them take;
#     - KeepLogFree quest log slots are kept free while a bot holds one, by
#       letting go of what a player would first: failed quests, grey ones,
#       ones for other zones, then the lowest -- never a dungeon quest, one
#       done, or the one it is out doing;
#     - a bot with one done walks to whoever takes it back on its continent
#       before it queues again, and hands it in there (playerbots' questing
#       picks the reward; if it has not in a minute, it is handed in with the
#       reward that suits the bot best);
#     - one gone grey is let go once the bot is out of its dungeon, and one
#       that QuestRuns runs of its dungeon (on a split dungeon, its wing) have
#       not finished is let go and not taken again.
#
#   .pbp dungeons shows what is going on, .pbp dungeons bands the dungeons in
#   each level band, and .pbp dungeons send <dungeon> (its dungeon finder id,
#   or part of its name) queues a party for it now, quest or no quest, to see
#   one through. The dungeon finder must be on (DungeonFinder.OptionsMask in
#   worldserver.conf).
#
#   Without mod-dungeon-clear in the build none of this exists: switched on,
#   it says so at startup and does nothing.
#
###############################################################################

#    PlayerbotsPlus.BotDungeons.Enable
#        Off by default. Switched off, nobody new queues, the queues it made
#        are left, and runs going on finish and let their party go.
#        Default: 0
PlayerbotsPlus.BotDungeons.Enable = 0

#    PlayerbotsPlus.BotDungeons.CheckSeconds
#        How often a party is looked for (5-3600). One party at most a look.
#        Default: 30
PlayerbotsPlus.BotDungeons.CheckSeconds = 30

#    PlayerbotsPlus.BotDungeons.MaxRuns
#    PlayerbotsPlus.BotDungeons.MaxWorldTickMs
#        Parties in the queue and runs going on, together, at most (0-100);
#        and no new party while the world tick averages more than this many
#        milliseconds (0: no such check). Each run is a dungeon instance for
#        the map threads to update; the bots in it were online anyway. .pbp
#        dungeons shows the tick now.
#        Default: 5, 200
PlayerbotsPlus.BotDungeons.MaxRuns = 5
PlayerbotsPlus.BotDungeons.MaxWorldTickMs = 200

#    PlayerbotsPlus.BotDungeons.OnlyWithPlayersOnline
#        No new party while nobody is playing: when the last player logs off,
#        the parties still waiting in the queue leave it, and the runs going
#        on carry on to their end; nothing new starts until someone logs in.
#        With playerbots logging its bots out when the last player leaves
#        (Playerbots.DisabledWithoutRealPlayer), give its logout delay time for
#        a run to finish.
#        Default: 1
PlayerbotsPlus.BotDungeons.OnlyWithPlayersOnline = 1

#    PlayerbotsPlus.BotDungeons.QuestRequired
#        1: a party only goes where at least one of it holds a quest for the
#        dungeon (the others go along). 0: any dungeon of their level, those
#        held quests for still first. With 1, a level band whose dungeons
#        nobody free holds a quest for gets no runs (LevelBands).
#        Default: 1
PlayerbotsPlus.BotDungeons.QuestRequired = 1

#    PlayerbotsPlus.BotDungeons.AloneMinutes
#        How long a party's bots wait in the queue each on their own, where a
#        player who queues for the dungeon can be matched with them, before
#        they queue together as a party (playerbots lets the dungeon finder
#        make a group of bots only from a party). 0: as a party straight away.
#        Less than QueueMinutes.
#        Default: 2
PlayerbotsPlus.BotDungeons.AloneMinutes = 2

#    PlayerbotsPlus.BotDungeons.QueueMinutes
#        A party still in the queue after this long leaves it (1-240).
#        Default: 15
PlayerbotsPlus.BotDungeons.QueueMinutes = 15

#    PlayerbotsPlus.BotDungeons.CooldownMinutes
#    PlayerbotsPlus.BotDungeons.FailCooldownMinutes
#        After a run, how long before a bot queues again; after a failed one.
#        Default: 15, 30
PlayerbotsPlus.BotDungeons.CooldownMinutes = 15
PlayerbotsPlus.BotDungeons.FailCooldownMinutes = 30

#    PlayerbotsPlus.BotDungeons.NoProgressMinutes
#    PlayerbotsPlus.BotDungeons.MaxRunMinutes
#        A run with nothing moving forward this long fails (0: never for
#        that), and any run this long (10-1440). Waiting for a dead tank to
#        be rezzed counts as nothing moving, but a rez comes within a minute
#        or two of the fight, and mod-dungeon-clear gives up on one long
#        before this (DungeonClear.PostCombatRezTimeoutSecs).
#        Default: 10, 120
PlayerbotsPlus.BotDungeons.NoProgressMinutes = 10
PlayerbotsPlus.BotDungeons.MaxRunMinutes = 120

#    PlayerbotsPlus.BotDungeons.LootSeconds
#        After the last boss, how long before they leave. The clear itself
#        waits for the last boss's loot first.
#        Default: 30
PlayerbotsPlus.BotDungeons.LootSeconds = 30

#    PlayerbotsPlus.BotDungeons.AvoidAfterFailures
#    PlayerbotsPlus.BotDungeons.AvoidMinutes
#        A dungeon whose runs failed this many times in a row (0: never) is
#        not gone to for this long.
#        Default: 3, 120
PlayerbotsPlus.BotDungeons.AvoidAfterFailures = 3
PlayerbotsPlus.BotDungeons.AvoidMinutes = 120

#    PlayerbotsPlus.BotDungeons.LevelBands
#    PlayerbotsPlus.BotDungeons.LevelBandRuns
#        The runs shared out by level. Each dungeon is in the band its level
#        is in -- the level the dungeon finder recommends for it -- and
#        LevelBandRuns says how many runs each band is meant to have going, in
#        the same order (a band given no number has 1, and 0 means only a
#        place nobody else can use). A free place goes to the band furthest
#        under its share; between equals, the bigger share, then the lower
#        band. So with MaxRuns at the sum of the shares, every band ends up
#        with its share: the defaults are a run in each band and four more at
#        the top end, for MaxRuns = 10. A band that cannot make a party just
#        then (no tank free of its level, say) is passed over and its place
#        goes to the next band; it is first in line when a run ends. A
#        dungeon in none of the bands is not gone to. Empty LevelBands: no
#        bands, any dungeon, the ones the most free bots hold quests for
#        first. .pbp dungeons shows each band's runs and why one is short;
#        .pbp dungeons bands, the dungeons in each.
#        Default: "15-19,20-29,30-39,40-49,50-59,60-69,70-80", "1,1,1,1,1,1,4"
PlayerbotsPlus.BotDungeons.LevelBands = "15-19,20-29,30-39,40-49,50-59,60-69,70-80"
PlayerbotsPlus.BotDungeons.LevelBandRuns = "1,1,1,1,1,1,4"

#    PlayerbotsPlus.BotDungeons.Quests
#        Bots take, keep, hand in and let go of dungeon quests (above). 0
#        leaves quests to playerbots: with QuestRequired on, few parties then.
#        Default: 1
PlayerbotsPlus.BotDungeons.Quests = 1

#    PlayerbotsPlus.BotDungeons.QuestRange
#        Yards: the farthest a bot walks to a quest giver (50-20000); twice
#        this to hand one in.
#        Default: 1500
PlayerbotsPlus.BotDungeons.QuestRange = 1500

#    PlayerbotsPlus.BotDungeons.QuestWalksPerMinute
#    PlayerbotsPlus.BotDungeons.QuestWalkMinutes
#    PlayerbotsPlus.BotDungeons.QuestLookMinutes
#        Bots sent off to take or hand in quests, all told, a minute; a walk
#        not there after this many minutes is given up (and that place not
#        walked to again by that bot); and a bot is looked at for quests at
#        most this often.
#        Default: 10, 15, 30
PlayerbotsPlus.BotDungeons.QuestWalksPerMinute = 10
PlayerbotsPlus.BotDungeons.QuestWalkMinutes = 15
PlayerbotsPlus.BotDungeons.QuestLookMinutes = 30

#    PlayerbotsPlus.BotDungeons.QuestRuns
#        Runs of its dungeon (its wing, on a split one) that do not finish a
#        quest before the bot lets it go and does not take it again (1-100).
#        Counted while the server is up.
#        Default: 4
PlayerbotsPlus.BotDungeons.QuestRuns = 4

#    PlayerbotsPlus.BotDungeons.KeepLogFree
#        Quest log slots kept free while a bot holds a dungeon quest (2-10).
#        Playerbots clears out a log with fewer than two free, starting with
#        the quests one cannot do alone.
#        Default: 3
PlayerbotsPlus.BotDungeons.KeepLogFree = 3

###############################################################################
#
#   CITY HANGOUTS
#
#   On a real server everyone parks in the same places: the Trade District,
#   the Commons, the Valley of Strength, outside the bank in Dalaran --
#   mounted on their best mount, sat on a bench, or stood there AFK.
#   Playerbots never sends a bot anywhere in particular: one with nothing to
#   do in a city walks from NPC to NPC, and its "rest" is 30 seconds sat
#   wherever it happens to be.
#
#   Every CheckSeconds, each spot with room may take one more (RecruitChance)
#   of the idle random bots within RecruitRange of it, in its zone and on its
#   level of it (not up in the Ruins of Lordaeron over the Undercity, or down
#   in Crystalsong under Dalaran): not grouped, not queued for a dungeon or a
#   battleground, not questing, flying, gathering or fighting, not one a real
#   player has targeted, and not one that hung out in the last
#   CooldownMinutes. It walks over (playerbots' own "go camp") to a place of
#   its own in the spot -- on the ground within HeightTolerance of the
#   middle's height, in sight of the middle, indoors or out the way the
#   middle is (so not inside the inn off the Valley of Strength), out of the
#   water and any fire, not in a vendor or anyone else, and one you can walk
#   to, so not the top of a market stall -- and stays StayMinutesMin to
#   StayMinutesMax:
#
#     * on a free bench within BenchRange, in sight of the middle
#       (BenchChance, when there is one; a seat whose name has one of
#       BenchWords). Orgrimmar has no benches at all, so nobody there
#       goes looking: it is one of the others;
#     * mounted (MountedChance), if it can ride and its place is out in
#       the open -- playerbots puts an idle random bot on its best mount
#       anyway; one whose place is under a roof gets off there;
#     * sat on the ground (SitChance), or else just standing about;
#     * and, AfkChance of the time, AFK: the flag, so it shows <AFK>. With
#       mod-ollama-chat, an AFK bot says nothing and reacts to nothing until
#       someone talks to it -- a whisper, a line that names it -- and then it
#       is back, and knows it had stepped away.
#
#   Once it is there its playerbots AI is held, the way a parked player does
#   nothing -- otherwise playerbots stands a sitting bot up and takes its AFK
#   off on its very next tick. An invite (group, guild, arena team), a trade,
#   a duel, a queue or a fight lets it go at once, as does being moved off
#   the spot -- except a duel at a spot outside the gates (see DUELS AT THE
#   CITY GATES), which is what that crowd is there for. When its time is up
#   it stands and goes about its business.
#   Switching hangouts or the module off lets everyone go at once; if the
#   module stopped running altogether, the hold would run out by itself
#   within five seconds. Nothing happens while no real player is online.
#
#   The idle bots already in a city are seldom enough: playerbots sends only
#   a few bots to the capitals (Playerbots.ProbTeleToBankers of its random
#   teleports, every two to eight hours a bot), so after the first half hour
#   or so of a session there is nobody left there to recruit. So a spot with
#   fewer than BringInFill percent of its room taken also gets bots fetched
#   from elsewhere (BringIn), up to BringInPerMinute a minute in all, the
#   cities someone is in first: random bots of the city's side, of
#   BringInMinLevel or more (58 for Shattrath, 68 for Dalaran), out in the
#   open world on their own, not wanted by anyone, and with no real player
#   within 150 yards to see them go.
#
#     * While someone is in that city, a fetched bot comes in at an inn
#       within ArrivalRange of the spot, the way people hearth in -- the
#       nearest one friendly to its side, so never the other side's inn in
#       Dalaran -- and walks over from there; no more than one every
#       InnArrivalSeconds in a city, whichever of its spots it is for. It
#       turns up a few steps in front of the innkeeper where nobody stands,
#       off its mount and at the keyboard, and sets off at once: not stood
#       <AFK> on its horse in the innkeeper's face. One that finds no place
#       at its spot within a few seconds wanders over to it anyway. A spot
#       with no inn in reach only gets bots while nobody is in its city.
#     * While nobody is, it is put down in the middle of the spot and walks
#       to its place, so the spot is already busy when someone gets there.
#       Once it is done, it goes back to where it was fetched from, so long
#       as nobody would see it vanish or turn up there; otherwise it stays
#       and goes about its business like any other bot in town.
#
#   Wherever a bot ends up, it is on the spot's own floor: every place is
#   checked to be on the ground within HeightTolerance of the middle's
#   height, in sight of the middle and reachable on foot from it -- so never
#   under the city, on a roof or inside a wall -- and the inns it arrives at
#   are where their innkeepers stand.
#
#   With PlayerbotsPlus.Debug on, each one is logged as it heads over,
#   settles and leaves; ".pbp status" counts them.
#
###############################################################################

#    PlayerbotsPlus.Hangout.Enable
#        Default: 1
PlayerbotsPlus.Hangout.Enable = 1

#    PlayerbotsPlus.Hangout.CheckSeconds
#    PlayerbotsPlus.Hangout.RecruitChance
#    PlayerbotsPlus.Hangout.RecruitRange
#        How often each spot may take one more bot (at most 20 seconds), the
#        chance it does, and how far from the spot (yards) its bots come from.
#        Default: 5, 50, 300
PlayerbotsPlus.Hangout.CheckSeconds = 5
PlayerbotsPlus.Hangout.RecruitChance = 50
PlayerbotsPlus.Hangout.RecruitRange = 300

#    PlayerbotsPlus.Hangout.BringIn
#    PlayerbotsPlus.Hangout.BringInFill
#    PlayerbotsPlus.Hangout.BringInPerMinute
#    PlayerbotsPlus.Hangout.BringInMinLevel
#    PlayerbotsPlus.Hangout.ArrivalRange
#    PlayerbotsPlus.Hangout.InnArrivalSeconds
#        Fetching bots from elsewhere for spots short of them (see above): on
#        or off; how full (percent of each spot's room) it keeps them; how
#        many bots a minute it may fetch, all spots together (at most 120);
#        the lowest level it fetches; how far from a spot (yards) an inn may
#        be for its bots to arrive at while someone is in the city; and, while
#        someone is, how many seconds apart they come in at that city's inns
#        (1 to 60), so it is people drifting in, not a crowd appearing at
#        once. A spot can still fill all the way up with bots already in
#        town.
#        Default: 1, 75, 15, 10, 400, 5
PlayerbotsPlus.Hangout.BringIn = 1
PlayerbotsPlus.Hangout.BringInFill = 75
PlayerbotsPlus.Hangout.BringInPerMinute = 15
PlayerbotsPlus.Hangout.BringInMinLevel = 10
PlayerbotsPlus.Hangout.ArrivalRange = 400
PlayerbotsPlus.Hangout.InnArrivalSeconds = 5

#    PlayerbotsPlus.Hangout.StayMinutesMin
#    PlayerbotsPlus.Hangout.StayMinutesMax
#    PlayerbotsPlus.Hangout.CooldownMinutes
#    PlayerbotsPlus.Hangout.TravelSeconds
#        How long a bot stays (at most 60 minutes), how long before it hangs
#        out again, and how long it has to get there before it gives up.
#        Default: 5, 20, 45, 180
PlayerbotsPlus.Hangout.StayMinutesMin = 5
PlayerbotsPlus.Hangout.StayMinutesMax = 20
PlayerbotsPlus.Hangout.CooldownMinutes = 45
PlayerbotsPlus.Hangout.TravelSeconds = 180

#    PlayerbotsPlus.Hangout.BenchChance
#    PlayerbotsPlus.Hangout.MountedChance
#    PlayerbotsPlus.Hangout.SitChance
#    PlayerbotsPlus.Hangout.AfkChance
#        How it spends it, tried in this order: a bench (when one is free),
#        mounted (when it can ride there), sat on the ground, else standing.
#        AfkChance is on top of any of them.
#        Default: 60, 45, 35, 35
PlayerbotsPlus.Hangout.BenchChance = 60
PlayerbotsPlus.Hangout.MountedChance = 45
PlayerbotsPlus.Hangout.SitChance = 35
PlayerbotsPlus.Hangout.AfkChance = 35

#    PlayerbotsPlus.Hangout.BenchRange
#    PlayerbotsPlus.Hangout.BenchWords
#    PlayerbotsPlus.Hangout.HeightTolerance
#        How far from where it arrives (yards) a bench may be; what counts as
#        a bench (part of a seat's name, separated by |: "Bench", "Stone
#        Bench" and "Wooden Bench" all have "bench"; chairs are mostly
#        indoors); and how far up or down from a spot's middle (yards) a
#        place in it may be.
#        Default: 25, "bench", 6
PlayerbotsPlus.Hangout.BenchRange = 25
PlayerbotsPlus.Hangout.BenchWords = "bench"
PlayerbotsPlus.Hangout.HeightTolerance = 6

#    PlayerbotsPlus.Hangout.Spot.<Name>
#        Where people hang out: "map x y z radius capacity name". x y z is
#        the middle (a place a player can stand: these are taken from a
#        mailbox, a teleport point, a flight master); radius (3-60 yards)
#        how far from it a place may be (grown to fit its people: see
#        RoomPerBot); capacity how many bots at most -- with CityWeights on,
#        its part of its city's places against the city's other spots of its
#        kind (hot or not); name what bots call it ("the Trade District in
#        Stormwind"), its last words the city. Add as many as you like, one
#        key each; capacity 0 turns one off. With no Spot keys at all, these
#        are the defaults:
#          Orgrimmar: the Valley of Strength -- in front of the inn and the
#          auction house, the bank, the open middle of it and just inside the
#          gates (the middle and the gates' z are a little above the ground,
#          so a place may be found up the slopes too) -- the Drag, the Valley
#          of Honor, and outside the city the gates and the zeppelin tower.
#          Stormwind: the Trade District, outside the auction house and the
#          bank, the Valley of Heroes, Cathedral Square, the Mage Quarter, the
#          Dwarven District, Old Town, the harbor and outside the gates.
#          Thunder Bluff: the middle of it (its teleport point), among the
#          trainers and below the auction house, and outside the bank.
#          Dalaran (from level 68, both sides): outside both banks, Runeweaver
#          Square (to one side of the statue, which nobody sees through),
#          the fountain in the Eventide and Krasus' Landing -- none of them in
#          the Silver Enclave or Sunreaver's Sanctuary, whose guards see off
#          the other side.
#        Outside the gates of Orgrimmar and of Stormwind is where people duel
#        (see DUELS AT THE CITY GATES). A city's spots fill evenly, the
#        emptiest first, and never with anyone standing in a fire (a bonfire
#        included). A spot's middle is somewhere open, never inside a statue
#        or a fountain: every place is checked to be in sight of it, through
#        anything but a gameobject's small model (a mailbox -- most middles
#        are one -- a crate or a holiday decoration). A spot nobody can be
#        put at says so in the log, once; .pbp hangouts shows why.
#        Maps: 0 Eastern Kingdoms, 1 Kalimdor, 530 Outland and the Blood
#        Elf and Draenei lands, 571 Northrend.
PlayerbotsPlus.Hangout.Spot.StormwindTrade = "0 -8833.4 628.6 94.0 22 16 the Trade District in Stormwind"
PlayerbotsPlus.Hangout.Spot.StormwindAuction = "0 -8815.2 652.9 94.9 14 12 outside the auction house in Stormwind"
PlayerbotsPlus.Hangout.Spot.StormwindBank = "0 -8914.0 621.5 99.6 14 10 the bank in Stormwind"
PlayerbotsPlus.Hangout.Spot.StormwindValley = "0 -8955.0 525.0 96.4 20 10 the Valley of Heroes in Stormwind"
PlayerbotsPlus.Hangout.Spot.StormwindCathedral = "0 -8635.0 800.0 97.0 24 14 Cathedral Square in Stormwind"
PlayerbotsPlus.Hangout.Spot.StormwindMageQuarter = "0 -9010.0 850.0 106.0 18 8 the Mage Quarter in Stormwind"
PlayerbotsPlus.Hangout.Spot.StormwindDwarven = "0 -8425.0 595.0 94.8 18 6 the Dwarven District in Stormwind"
PlayerbotsPlus.Hangout.Spot.StormwindOldTown = "0 -8675.0 445.0 99.5 16 6 Old Town in Stormwind"
PlayerbotsPlus.Hangout.Spot.StormwindHarbor = "0 -8565.5 1195.5 5.4 20 8 the harbor in Stormwind"
PlayerbotsPlus.Hangout.Spot.StormwindGates = "0 -9100.0 380.0 93.8 22 14 outside the gates of Stormwind"
PlayerbotsPlus.Hangout.Spot.IronforgeCommons = "0 -4918.9 -940.4 501.6 22 12 the Commons in Ironforge"
PlayerbotsPlus.Hangout.Spot.OrgrimmarValley = "1 1657.9 -4433.0 17.5 22 14 the Valley of Strength in Orgrimmar"
PlayerbotsPlus.Hangout.Spot.OrgrimmarBank = "1 1615.6 -4391.6 10.3 14 8 outside the bank in Orgrimmar"
