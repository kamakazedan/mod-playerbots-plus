[worldserver]

###############################################################################
#
#   PLAYERBOTS PLUS
#
#   Random bots doing what real players do, without an LLM: trading on the
#   auction house, hanging out where players do in the cities, getting
#   unstuck, getting back up after dying, and using raid marks the way groups
#   do; and the stock lines playerbots whispers that nobody needs, muted.
#   Works with mod-playerbots. mod-ollama-chat, when it is in the same build,
#   has the bots talk about all of it in their own words; without it, they
#   just do it.
#
#   GM commands:
#       .pbp status          what it is doing
#       .pbp visit [name]    that bot (or the one selected) trades now
#       .pbp reload          re-read this file (.reload config does too)
#
###############################################################################

#    PlayerbotsPlus.Enable
#        The whole module. Switched off, bots it was holding (sat down at a
#        hangout, AFK, kept on foot) are let go at once, and nothing is muted.
#        Default: 1
PlayerbotsPlus.Enable = 1

#    PlayerbotsPlus.Debug
#        More of what the bots do, in the server log at INFO
#        (module.playerbotsplus): each one heading over to a hangout, settling
#        and leaving; a rogue's sap step by step; a dead bot released.
#        Default: 0
PlayerbotsPlus.Debug = 0

###############################################################################
#
#   THE AUCTION HOUSE
#
#   Random bots in a capital city go to the auction house now and then, like
#   players: they collect their auction mail, put up what they have no use
#   for, and buy an upgrade they can afford or what their profession uses.
#
#   The auctions are real ones under the bot's own name, in its faction's
#   auction house: a real player can buy them, and the bots buy real players'
#   auctions too. The money is real: the deposit, the house's cut, and the
#   sale paid by mail an hour later, as for anyone. A bot does not walk to the
#   auctioneer; standing anywhere in the city is enough.
#
#   What a bot sells is what playerbots itself would take to the auction house
#   rather than a vendor: anything of common (white) quality or better that is
#   not soulbound, not for its quests, not for its professions and not worth
#   wearing -- cloth, leather, herbs and ore it has no profession for, gear it
#   will never put on. One whole stack per auction.
#
#   What it asks, per one: a little under the cheapest one already up (any
#   seller's, the auction house bot's too); if there is none, what it is worth
#   (a multiple of the vendor price); never more than someone of the item's
#   level could sensibly pay, and never so little that a vendor would pay
#   more -- if the market is already that low, it keeps it for a vendor. If it
#   comes back unsold, the bot asks less next time, and after a couple of
#   tries gives up on it.
#
###############################################################################

#    PlayerbotsPlus.Market.Enable
#        Default: 1
PlayerbotsPlus.Market.Enable = 1

#    PlayerbotsPlus.Market.IntervalSeconds
#    PlayerbotsPlus.Market.VisitsPerInterval
#        Every IntervalSeconds, this many bots that are due go to the auction
#        house.
#        Default: 10 seconds, 1 bot
PlayerbotsPlus.Market.IntervalSeconds = 10
PlayerbotsPlus.Market.VisitsPerInterval = 1

#    PlayerbotsPlus.Market.VisitCooldownMinutes
#        After a visit, a bot goes again after a random time in this range
#        (minutes, min:max). A bot first seen in a city goes some time within
#        the max, so they do not all go at once.
#        Default: 40:120
PlayerbotsPlus.Market.VisitCooldownMinutes = 40:120

#    PlayerbotsPlus.Market.MinLevel
#        Bots below this level stay out of it.
#        Default: 10
PlayerbotsPlus.Market.MinLevel = 10

#    PlayerbotsPlus.Market.ExtraZoneOrAreaIds
#        Where bots trade besides the capitals (where the game rests you "in a
#        city"): zone or area ids, separated by commas. Neither of the default
#        two has an auction house; a bot there uses its faction's, as a player
#        would by flying over. Empty for capitals only.
#        3703 = Shattrath City, 4395 = Dalaran.
#        Default: 3703,4395
PlayerbotsPlus.Market.ExtraZoneOrAreaIds = 3703,4395

#    PlayerbotsPlus.Market.MaxItemChecksPerVisit
#        How many items a visit asks playerbots about (is it spare? is it an
#        upgrade?): each one is a little work for the server.
#        Default: 30
PlayerbotsPlus.Market.MaxItemChecksPerVisit = 30

#    PlayerbotsPlus.Market.CollectMail
#        Bots collect their auction mail when they go: what they sold, what
#        came back unsold, what they bought. Without it they cannot buy.
#        Default: 1
PlayerbotsPlus.Market.CollectMail = 1

#    PlayerbotsPlus.Market.EquipBought
#        A bot that bought an upgrade puts it on.
#        Default: 1
PlayerbotsPlus.Market.EquipBought = 1

#    PlayerbotsPlus.Market.LogTrades
#        Every visit that did something, and every sale, in the server log
#        (module.playerbotsplus, info).
#        Default: 0
PlayerbotsPlus.Market.LogTrades = 0

# --- selling -------------------------------------------------------------------

#    PlayerbotsPlus.Market.Sell.Enable
#        Default: 1
PlayerbotsPlus.Market.Sell.Enable = 1

#    PlayerbotsPlus.Market.Sell.MinQuality
#    PlayerbotsPlus.Market.Sell.MaxQuality
#        0 poor, 1 common, 2 uncommon, 3 rare, 4 epic, 5 legendary.
#        Default: 1 to 4
PlayerbotsPlus.Market.Sell.MinQuality = 1
PlayerbotsPlus.Market.Sell.MaxQuality = 4

#    PlayerbotsPlus.Market.Sell.MaxPerVisit
#    PlayerbotsPlus.Market.Sell.MaxAuctionsPerBot
#        How many stacks a bot puts up in one visit, and how many it has up at
#        once at most.
#        Default: 3, 8
PlayerbotsPlus.Market.Sell.MaxPerVisit = 3
PlayerbotsPlus.Market.Sell.MaxAuctionsPerBot = 8

#    PlayerbotsPlus.Market.Sell.MaxBotAuctionsPerHouse
#        All random bots together never have more than this many up in one
#        auction house.
#        Default: 2000
PlayerbotsPlus.Market.Sell.MaxBotAuctionsPerHouse = 2000

#    PlayerbotsPlus.Market.Sell.MaxRelists
#        Something that came back unsold more often than this is left for a
#        vendor.
#        Default: 2
PlayerbotsPlus.Market.Sell.MaxRelists = 2

#    PlayerbotsPlus.Market.Sell.DurationWeights
#        How often a bot picks 12, 24 and 48 hours.
#        Default: 20,40,40
PlayerbotsPlus.Market.Sell.DurationWeights = 20,40,40

#    PlayerbotsPlus.Market.Sell.MaxBuyoutGold
#        No bot auction has a buyout above this.
#        Default: 50000
PlayerbotsPlus.Market.Sell.MaxBuyoutGold = 50000

# --- buying ---------------------------------------------------------------------

#    PlayerbotsPlus.Market.Buy.Enable
#    PlayerbotsPlus.Market.Buy.Upgrades
#    PlayerbotsPlus.Market.Buy.Materials
#        Bots buy gear that playerbots rates an upgrade for them (weapons,
#        armour, bigger bags), and what their professions use to skill up.
#        Default: 1, 1, 1
PlayerbotsPlus.Market.Buy.Enable = 1
PlayerbotsPlus.Market.Buy.Upgrades = 1
PlayerbotsPlus.Market.Buy.Materials = 1

#    PlayerbotsPlus.Market.Buy.MaxPerVisit
#        Default: 2
PlayerbotsPlus.Market.Buy.MaxPerVisit = 2

#    PlayerbotsPlus.Market.Buy.MaxShareOfGoldPct
#        The most a bot spends on any one thing, as a share of its gold.
#        Default: 25
PlayerbotsPlus.Market.Buy.MaxShareOfGoldPct = 25

#    PlayerbotsPlus.Market.Buy.ReserveCopperPerLevel
#        Gold a bot never spends here, per level, for repairs and training.
#        Default: 2000 (20 silver a level: 16 gold at 80)
PlayerbotsPlus.Market.Buy.ReserveCopperPerLevel = 2000

#    PlayerbotsPlus.Market.Buy.UpgradeMinQuality
#        Default: 2 (uncommon)
PlayerbotsPlus.Market.Buy.UpgradeMinQuality = 2

#    PlayerbotsPlus.Market.Buy.UpgradeLevelWindow
#        Gear made for the bot's level or up to this many levels below it.
#        Default: 6
PlayerbotsPlus.Market.Buy.UpgradeLevelWindow = 6

#    PlayerbotsPlus.Market.Buy.MaterialsMaxPctOfValue
#        The most a bot pays per one for materials, as a percentage of what
#        they are worth (Market.Price.GoodsValuePct of the vendor price).
#        Default: 200
PlayerbotsPlus.Market.Buy.MaterialsMaxPctOfValue = 200

# --- prices -----------------------------------------------------------------------
#
#   All per one item. "Wealth" is how much gold someone of a level has to
#   spend: WealthBaseCopper * e^(level / WealthGrowthLevels) -- with the
#   defaults about 2g at 10, 17g at 30, 117g at 50, 300g at 60, 2000g at 80.

#    PlayerbotsPlus.Market.Price.GearValuePct
#        What gear (weapons, armour) is worth when nobody else has one up, as a
#        percentage of its vendor price, by quality: poor, common, uncommon,
#        rare, epic, legendary, heirloom.
#        Default: 100,250,500,1000,2500,4000,4000
PlayerbotsPlus.Market.Price.GearValuePct = 100,250,500,1000,2500,4000,4000

#    PlayerbotsPlus.Market.Price.GoodsValuePct
#        The same for everything else: cloth, herbs, ore, potions...
#        Default: 300
PlayerbotsPlus.Market.Price.GoodsValuePct = 300

#    PlayerbotsPlus.Market.Price.FloorPctOfVendor
#        Never listed for less than this percentage of the vendor price: the
#        house keeps 5% of a sale (15% in the neutral ones).
#        Default: 110
PlayerbotsPlus.Market.Price.FloorPctOfVendor = 110

#    PlayerbotsPlus.Market.Price.WealthBaseCopper
#    PlayerbotsPlus.Market.Price.WealthGrowthLevels
#        Default: 10000, 10.5
PlayerbotsPlus.Market.Price.WealthBaseCopper = 10000
PlayerbotsPlus.Market.Price.WealthGrowthLevels = 10.5

#    PlayerbotsPlus.Market.Price.GearCapPctOfWealth
#        One piece of gear never costs more than this share (percent) of the
#        wealth at its level, by quality as above. A bot buying an upgrade
#        pays no more than this at its own level.
#        Default: 2,5,20,50,120,300,300
PlayerbotsPlus.Market.Price.GearCapPctOfWealth = 2,5,20,50,120,300,300

#    PlayerbotsPlus.Market.Price.StackCapPctOfWealth
#        A full stack of anything else never costs more than this share.
#        Default: 20
PlayerbotsPlus.Market.Price.StackCapPctOfWealth = 20

#    PlayerbotsPlus.Market.Price.UndercutPct
#        How far under the cheapest one up a bot goes (percent, min:max).
#        Default: 1:5
PlayerbotsPlus.Market.Price.UndercutPct = 1:5

#    PlayerbotsPlus.Market.Price.RelistDiscountPct
#        Asked this much less (percent) for every time it came back unsold.
#        Default: 15
PlayerbotsPlus.Market.Price.RelistDiscountPct = 15

###############################################################################
#
#   CITY HANGOUTS
#
#   On a real server everyone parks in the same places: the Trade District,
#   the Commons, the Valley of Strength, outside the bank in Dalaran --
#   mounted on their best mount, sat on a bench, or stood there AFK.
#   Playerbots never sends a bot anywhere in particular: one with nothing to
#   do in a city walks from NPC to NPC, and its "rest" is 30 seconds sat
#   wherever it happens to be.
#
#   Every CheckSeconds, each spot with room may take one more (RecruitChance)
#   of the idle random bots within RecruitRange of it, in its zone and on its
#   level of it (not up in the Ruins of Lordaeron over the Undercity, or down
#   in Crystalsong under Dalaran): not grouped, not queued for a dungeon or a
#   battleground, not questing, flying, gathering or fighting, not one a real
#   player has targeted, and not one that hung out in the last
#   CooldownMinutes. It walks over (playerbots' own "go camp") to a place of
#   its own in the spot -- on the ground within HeightTolerance of the
#   middle's height, in sight of the middle, out of the water, and one you
#   can walk to, so not the top of a market stall -- and stays StayMinutesMin
#   to StayMinutesMax:
#
#     * on a free bench within BenchRange, in sight of the middle
#       (BenchChance, when there is one; a seat whose name has one of
#       BenchWords);
#     * mounted (MountedChance), if it can ride and it is outdoors --
#       playerbots puts an idle random bot on its best mount anyway;
#     * sat on the ground (SitChance), or else just standing about;
#     * and, AfkChance of the time, AFK: the flag, so it shows <AFK>. With
#       mod-ollama-chat, an AFK bot says nothing and reacts to nothing until
#       someone talks to it -- a whisper, a line that names it -- and then it
#       is back, and knows it had stepped away.
#
#   Once it is there its playerbots AI is held, the way a parked player does
#   nothing -- otherwise playerbots stands a sitting bot up and takes its AFK
#   off on its very next tick. An invite (group, guild, arena team), a trade,
#   a duel, a queue or a fight lets it go at once, as does being moved off
#   the spot. When its time is up it stands and goes about its business.
#   Switching hangouts or the module off lets everyone go at once; if the
#   module stopped running altogether, the hold would run out by itself
#   within five seconds. Nothing happens while no real player is online.
#
#   The idle bots already in a city are seldom enough: playerbots sends only
#   a few bots to the capitals (Playerbots.ProbTeleToBankers of its random
#   teleports, every two to eight hours a bot), so after the first half hour
#   or so of a session there is nobody left there to recruit. So a spot with
#   fewer than BringInFill percent of its room taken also gets bots fetched
#   from elsewhere (BringIn), up to BringInPerMinute a minute in all, the
#   cities someone is in first: random bots of the city's side, of
#   BringInMinLevel or more (58 for Shattrath, 68 for Dalaran), out in the
#   open world on their own, not wanted by anyone, and with no real player
#   within 150 yards to see them go.
#
#     * While someone is in that city, a fetched bot comes in at an inn
#       within ArrivalRange of the spot, the way people hearth in -- the
#       nearest one friendly to its side, so never the other side's inn in
#       Dalaran -- and walks over from there; no more than one every eight
#       seconds in a city, whichever of its spots it is for. A spot with no
#       inn in reach only gets bots while nobody is in its city.
#     * While nobody is, it is put down in the middle of the spot and walks
#       to its place, so the spot is already busy when someone gets there.
#       Once it is done, it goes back to where it was fetched from, so long
#       as nobody would see it vanish or turn up there; otherwise it stays
#       and goes about its business like any other bot in town.
#
#   Wherever a bot ends up, it is on the spot's own floor: every place is
#   checked to be on the ground within HeightTolerance of the middle's
#   height, in sight of the middle and reachable on foot from it -- so never
#   under the city, on a roof or inside a wall -- and the inns it arrives at
#   are where their innkeepers stand.
#
#   With PlayerbotsPlus.Debug on, each one is logged as it heads over,
#   settles and leaves; ".pbp status" counts them.
#
###############################################################################

#    PlayerbotsPlus.Hangout.Enable
#        Default: 1
PlayerbotsPlus.Hangout.Enable = 1

#    PlayerbotsPlus.Hangout.CheckSeconds
#    PlayerbotsPlus.Hangout.RecruitChance
#    PlayerbotsPlus.Hangout.RecruitRange
#        How often each spot may take one more bot (at most 20 seconds), the
#        chance it does, and how far from the spot (yards) its bots come from.
#        Default: 5, 50, 300
PlayerbotsPlus.Hangout.CheckSeconds = 5
PlayerbotsPlus.Hangout.RecruitChance = 50
PlayerbotsPlus.Hangout.RecruitRange = 300

#    PlayerbotsPlus.Hangout.BringIn
#    PlayerbotsPlus.Hangout.BringInFill
#    PlayerbotsPlus.Hangout.BringInPerMinute
#    PlayerbotsPlus.Hangout.BringInMinLevel
#    PlayerbotsPlus.Hangout.ArrivalRange
#        Fetching bots from elsewhere for spots short of them (see above): on
#        or off; how full (percent of each spot's room) it keeps them; how
#        many bots a minute it may fetch, all spots together (at most 120);
#        the lowest level it fetches; and how far from a spot (yards) an inn
#        may be for its bots to arrive at while someone is in the city. A spot
#        can still fill all the way up with bots already in town.
#        Default: 1, 75, 15, 10, 400
PlayerbotsPlus.Hangout.BringIn = 1
PlayerbotsPlus.Hangout.BringInFill = 75
PlayerbotsPlus.Hangout.BringInPerMinute = 15
PlayerbotsPlus.Hangout.BringInMinLevel = 10
PlayerbotsPlus.Hangout.ArrivalRange = 400

#    PlayerbotsPlus.Hangout.StayMinutesMin
#    PlayerbotsPlus.Hangout.StayMinutesMax
#    PlayerbotsPlus.Hangout.CooldownMinutes
#    PlayerbotsPlus.Hangout.TravelSeconds
#        How long a bot stays (at most 60 minutes), how long before it hangs
#        out again, and how long it has to get there before it gives up.
#        Default: 5, 20, 45, 180
PlayerbotsPlus.Hangout.StayMinutesMin = 5
PlayerbotsPlus.Hangout.StayMinutesMax = 20
PlayerbotsPlus.Hangout.CooldownMinutes = 45
PlayerbotsPlus.Hangout.TravelSeconds = 180

#    PlayerbotsPlus.Hangout.BenchChance
#    PlayerbotsPlus.Hangout.MountedChance
#    PlayerbotsPlus.Hangout.SitChance
#    PlayerbotsPlus.Hangout.AfkChance
#        How it spends it, tried in this order: a bench (when one is free),
#        mounted (when it can ride there), sat on the ground, else standing.
#        AfkChance is on top of any of them.
#        Default: 60, 45, 35, 35
PlayerbotsPlus.Hangout.BenchChance = 60
PlayerbotsPlus.Hangout.MountedChance = 45
PlayerbotsPlus.Hangout.SitChance = 35
PlayerbotsPlus.Hangout.AfkChance = 35

#    PlayerbotsPlus.Hangout.BenchRange
#    PlayerbotsPlus.Hangout.BenchWords
#    PlayerbotsPlus.Hangout.HeightTolerance
#        How far from where it arrives (yards) a bench may be; what counts as
#        a bench (part of a seat's name, separated by |: "Bench", "Stone
#        Bench" and "Wooden Bench" all have "bench"; chairs are mostly
#        indoors); and how far up or down from a spot's middle (yards) a
#        place in it may be.
#        Default: 25, "bench", 6
PlayerbotsPlus.Hangout.BenchRange = 25
PlayerbotsPlus.Hangout.BenchWords = "bench"
PlayerbotsPlus.Hangout.HeightTolerance = 6

#    PlayerbotsPlus.Hangout.Spot.<Name>
#        Where people hang out: "map x y z radius capacity name". x y z is
#        the middle (a place a player can stand: these are taken from a
#        mailbox, a teleport point, a flight master); radius (3-60 yards)
#        how far from it a place may be; capacity how many bots at most;
#        name what bots call it ("the Trade District in Stormwind"). Add as
#        many as you like, one key each; capacity 0 turns one off. With no
#        Spot keys at all, these are the defaults.
#        Maps: 0 Eastern Kingdoms, 1 Kalimdor, 530 Outland and the Blood
#        Elf and Draenei lands, 571 Northrend.
PlayerbotsPlus.Hangout.Spot.StormwindTrade = "0 -8833.4 628.6 94.0 22 14 the Trade District in Stormwind"
PlayerbotsPlus.Hangout.Spot.StormwindBank = "0 -8914.0 621.5 99.6 14 8 the bank in Stormwind"
PlayerbotsPlus.Hangout.Spot.IronforgeCommons = "0 -4918.9 -940.4 501.6 22 12 the Commons in Ironforge"
PlayerbotsPlus.Hangout.Spot.OrgrimmarValley = "1 1657.9 -4433.0 17.5 22 10 the Valley of Strength in Orgrimmar"
PlayerbotsPlus.Hangout.Spot.OrgrimmarBank = "1 1615.6 -4391.6 10.3 14 6 outside the bank in Orgrimmar"
PlayerbotsPlus.Hangout.Spot.UndercityTrade = "0 1584.1 240.3 -52.2 16 10 the Trade Quarter in the Undercity"
PlayerbotsPlus.Hangout.Spot.ThunderBluffBank = "1 -1263.3 44.5 127.5 16 8 outside the bank in Thunder Bluff"
PlayerbotsPlus.Hangout.Spot.DarnassusBank = "1 9943.0 2497.7 1317.7 16 8 outside the bank in Darnassus"
PlayerbotsPlus.Hangout.Spot.ExodarHall = "530 -3965.7 -11653.6 -138.8 18 8 the main hall of the Exodar"
PlayerbotsPlus.Hangout.Spot.SilvermoonExchange = "530 9744.0 -7466.1 13.5 22 10 the Royal Exchange in Silvermoon"
PlayerbotsPlus.Hangout.Spot.ShattrathTerrace = "530 -1863.7 5430.0 -9.6 24 12 the Terrace of Light in Shattrath"
PlayerbotsPlus.Hangout.Spot.DalaranBank = "571 5958.1 617.3 650.6 18 12 outside the bank in Dalaran"
PlayerbotsPlus.Hangout.Spot.DalaranKrasus = "571 5813.4 453.4 658.8 16 8 Krasus' Landing in Dalaran"
PlayerbotsPlus.Hangout.Spot.DalaranMerchants = "571 5654.9 682.2 652.0 14 8 outside the Merchants' Bank in Dalaran"

###############################################################################
#
#   STUCK ON A MOUNT
#
#   Playerbots' loot code gets a mounted bot down before it opens something.
#   When the opening then fails -- a mining vein another bot has hold of, a
#   herb two bots went for at once, a body it cannot get close to -- the
#   thing is put off for a second, then two, four, up to sixteen, and never
#   written off while the bot is near it. In that pause the mount check --
#   once a second, for a random bot with nothing to fight -- puts it back on
#   its mount, so the next try starts with another dismount: the bot gets on
#   and off on the spot, every few seconds, for as long as nothing gives. (A
#   try that only got the bot down does not count as a failed one.)
#
#   A bot that mounts MountCount times in WindowSeconds without leaving
#   Radius yards of where it started, out of any fight, takes the hint: what
#   it was trying to loot -- its loot target, else the gathering node it is
#   out for, else a chest-like object at its feet -- is out of its reach for
#   IgnoreMinutes (not its loot target, held off in its loot list, written
#   off as a gathering node), so it goes and does something else. A random
#   bot on its own also goes on foot for WalkMinutes, so it does not start
#   again at the next herb. Every one is logged at INFO with where it
#   happened, who the bot was with and anyone else at the same thing. One
#   with nothing to loot is only logged (and, if it is on its own, kept on
#   foot). With mod-ollama-chat, the bot knows it was stuck when someone
#   asks, and may laugh it off.
#
###############################################################################

#    PlayerbotsPlus.Stuck.Enable
#        Default: 1
PlayerbotsPlus.Stuck.Enable = 1

#    PlayerbotsPlus.Stuck.MountCount
#    PlayerbotsPlus.Stuck.WindowSeconds
#    PlayerbotsPlus.Stuck.Radius
#        A stuck bot goes round every two or three seconds at first (the
#        pauses in between grow later), so four times in half a minute
#        catches it early. A bot that was in a fight at any time since the
#        first of those mounts does not count: one grinding mobs that stand
#        close together kills one, loots it, gets on its mount and straight
#        off again for the next, on the spot but not stuck.
#        Default: 4, 30, 6
PlayerbotsPlus.Stuck.MountCount = 4
PlayerbotsPlus.Stuck.WindowSeconds = 30
PlayerbotsPlus.Stuck.Radius = 6

#    PlayerbotsPlus.Stuck.IgnoreMinutes
#        Default: 10
PlayerbotsPlus.Stuck.IgnoreMinutes = 10

#    PlayerbotsPlus.Stuck.WalkMinutes
#        How long a random bot on its own (no group, no master, not in a
#        battleground) that was caught at it stays on foot. Playerbots puts a
#        bot on its mount only while it has the "mount" strategy, so that is
#        taken off it, and given back when the time is up -- at once if it
#        joins a group or gets a master, or Stuck.Enable or the module is
#        switched off. On foot, the loot code's get-down-and-wait never
#        starts: it walks to the next herb and picks it, the way a player
#        would, and when the time is up it rides again. A bot in a group, or
#        with a master, keeps its mount so it keeps up. Nothing is saved:
#        a bot that logs out gets its strategies afresh when it logs in --
#        unless someone gives it a strategy command ("nc +..." / "co -...")
#        or an outfit command while it is on foot, when playerbots saves its
#        strategies as they are, and it would come back without its mount
#        until it is next randomised ("nc +mount" puts it right). 0 leaves
#        every bot its mount. At most 120.
#        Default: 10
PlayerbotsPlus.Stuck.WalkMinutes = 10

###############################################################################
#
#   GETTING BACK UP
#
#   Playerbots leaves a bot that dies near you lying where it fell until you
#   tell it what to do, and mod-dungeon-clear keeps every dungeon body for a
#   rez. People don't wait to be told: when nobody left standing in the
#   group can resurrect -- no living priest, paladin, shaman or druid who has
#   learned the spell -- a dead bot releases, runs back, gets up and joins
#   the fight again.
#
#     * Someone alive can rez: the bot waits for it, for up to
#       WaitForRezSeconds of nobody fighting, then gives up waiting.
#     * Nobody can: it releases after ReleaseDelaySeconds.
#     * Its body is in a dungeon or raid: the ghost runs from the graveyard
#       to the entrance and walks in, which brings it back there, as it does
#       for anyone. RunBackSeconds bounds the run when it cannot path there.
#       A raid that will not let anyone in during a boss fight is tried again
#       every few seconds.
#     * In the open world the ghost walks back to its body, as playerbots
#       already does.
#
#   Only bots in a group with a real player. Never in battlegrounds or arenas,
#   and not while a mod-dungeon-clear run is on: the run decides how its party
#   is brought back (a rez, a wait, or calling the run off), and once it has
#   called the run off, this takes over.
#
###############################################################################

#    PlayerbotsPlus.Revive.Enable
#        Default: 1
PlayerbotsPlus.Revive.Enable = 1

#    PlayerbotsPlus.Revive.ReleaseDelaySeconds
#        How long a bot nobody can rez lies there before it releases.
#        Default: 5
PlayerbotsPlus.Revive.ReleaseDelaySeconds = 5

#    PlayerbotsPlus.Revive.WaitForRezSeconds
#        How long a bot waits for a rez from someone who could give one,
#        counted only while nobody in the group is fighting. 0 waits for good.
#        Default: 60
PlayerbotsPlus.Revive.WaitForRezSeconds = 60

#    PlayerbotsPlus.Revive.RunBackSeconds
#        The longest a ghost spends running from the graveyard to its
#        dungeon before it walks in anyway (about as long as the run takes).
#        Default: 40
PlayerbotsPlus.Revive.RunBackSeconds = 40

###############################################################################
#
#   RAID MARKS
#
#   Marks make the plan plain without anyone barking it:
#
#       skull     kill first -- putting it on a mob starts the fight
#       cross     kill next -- it becomes the skull when the skull dies
#       moon      polymorph (mage)            star     sap (rogue)
#       diamond   banish or fear (warlock)    circle   shackle undead (priest)
#       triangle  hibernate, roots, cyclone (druid)
#       square    freezing trap (hunter)
#
#   Each bot whose class can crowd-control is told which mark is its to
#   control (ClassIcons), with playerbots' crowd-control strategy turned on
#   if it lacked it (priests and rogues do by default). Mark the pack, then
#   put the skull on the mob to kill first: nothing happens until the skull
#   goes on -- that is playerbots, the skull is every bot's target -- and as
#   the pack comes in, each one controls its own mark. A sap has to land
#   before the pull, so the star is the exception: put it on a mob that is
#   not fighting and a rogue in the group sneaks over and saps it. It goes
#   into stealth first -- with Stealth still on cooldown it keeps following
#   and goes when it can, rather than walking up in plain sight and pulling
#   -- comes round to the mob's back (a mob only spots stealth in front of
#   it), stops, turns to it and saps. A rogue that cannot -- no Sap before
#   level 10, a mob Sap does not work on (undead, elementals, machines...),
#   no stealth in time -- leaves the mob alone; with mod-ollama-chat it says
#   why in party.
#
#   While someone in the group is marking (a mark changed in the last
#   InUseSeconds that this did not make), the skull moves on by itself when
#   its mob dies: to the cross, else to the nearest mob still fighting the
#   group that nobody marked to control and nothing is controlling
#   (AutoSkull). So the bots finish the loose mobs before they break
#   anything that is controlled. It only ever moves onto a mob already in
#   the fight: a cross on the next pack waits for its own skull. Groups that
#   do not mark see none of this.
#
#   In a 5-man dungeon playerbots' bots only crowd-control what is marked
#   for them; in raids and out in the world they also pick targets of their
#   own.
#
###############################################################################

#    PlayerbotsPlus.Marks.Enable
#        Default: 1
PlayerbotsPlus.Marks.Enable = 1

#    PlayerbotsPlus.Marks.ClassIcons
#        class:mark pairs, comma separated. Classes: warrior, paladin,
#        hunter, rogue, priest, deathknight, shaman, mage, warlock, druid.
#        Marks: star, circle, diamond, triangle, moon, square, cross, skull.
#        A paladin given a mark turns undead on it; shamans have no crowd
#        control in playerbots.
#        Default: "mage:moon, rogue:star, priest:circle, warlock:diamond, druid:triangle, hunter:square"
PlayerbotsPlus.Marks.ClassIcons = "mage:moon, rogue:star, priest:circle, warlock:diamond, druid:triangle, hunter:square"

#    PlayerbotsPlus.Marks.AddCcStrategy
#        Turn playerbots' crowd-control strategy on for those classes when a
#        bot lacks it -- never for a tank, which would drop out of bear form
#        to do it.
#        Default: 1
PlayerbotsPlus.Marks.AddCcStrategy = 1

#    PlayerbotsPlus.Marks.SapStar
#        A rogue bot saps the mob the star is put on, when nothing is fighting.
#        Default: 1
PlayerbotsPlus.Marks.SapStar = 1

#    PlayerbotsPlus.Marks.AutoSkull
#        With no cross in the fight to move to, the skull goes on the next
#        loose mob in it.
#        Default: 1
PlayerbotsPlus.Marks.AutoSkull = 1

#    PlayerbotsPlus.Marks.InUseSeconds
#        How long after someone last changed a mark the skull keeps moving
#        on by itself.
#        Default: 180
PlayerbotsPlus.Marks.InUseSeconds = 180

#    PlayerbotsPlus.Marks.SapStealthWaitSeconds
#    PlayerbotsPlus.Marks.SapApproachSeconds
#    PlayerbotsPlus.Marks.SapWaitSeconds
#        How long the rogue waits to go into stealth (Stealth cools down for
#        10 seconds after it breaks), and then how long it may take to sneak
#        round the mob and sap it, before it gives up -- not counting up to
#        SapWaitSeconds spent hanging back, out of sight, while a mob that
#        wanders about is on the move.
#
#        How close it may come in front is worked out the way the core does
#        it (the mob's level against the rogue's stealth): where its Sap
#        reaches further than that, it goes straight in; otherwise round the
#        side, out of sight, and in from behind, the side a mob never spots
#        stealth from. Every sap's outcome is logged at INFO, with the
#        distances, whatever PlayerbotsPlus.Debug says.
#        Default: 12, 40, 20
PlayerbotsPlus.Marks.SapStealthWaitSeconds = 12
PlayerbotsPlus.Marks.SapApproachSeconds = 40
PlayerbotsPlus.Marks.SapWaitSeconds = 20

###############################################################################
#
#   MUTED BOT LINES
#
#   Playerbots whispers a stock line for a lot of what bots do: "Using
#   [Hearthstone]", "Drinking [Conjured Water] (40%)", "AI was reset to
#   defaults", "I don't know this dungeon, lead the way!". The ones listed
#   here never reach you.
#
#   Only lines a bot sends as a whisper or in party or raid chat are looked
#   at, and only whole lines: "Staying" would mute that word alone, not
#   "staying here till you are back". A line another module sends for a bot
#   in its own words (mod-ollama-chat's) is never muted, so "Hi" on the list
#   mutes playerbots' stock "Hi" whisper on joining a group but never a
#   bot's own "hi".
#
#   Patterns are separated by ; (an item link starts with |, so | cannot be
#   the separator here), compared ignoring case; * matches anything, so
#   "Using |c*" is "Using " followed by an item link.
#
#   With mod-ollama-chat, the bots say much of the rest in their own words:
#   "Staying" and "Following" to an order, hello in party when they join a
#   group, a quest objective done in party rather than every kill whispered.
#   Mute playerbots' stock lines for those too, with this list instead of the
#   default (it is the default and then: orders; dying; the hellos on
#   joining; quest progress, "Kobold Vermin 3/10 [Kobold Camp Cleanup]" being
#   "* */* |c*|Hquest:*"; goodbyes; trades; and taxis):
#
#PlayerbotsPlus.Mute.Patterns = "AI was reset to defaults;Using |c*;Drinking |c*;Eating |c*;Feasting |c*;I don't know this dungeon, lead the way!;Staying;Following;Fleeing;Running away;Attacking;Releasing...;Meet me at the graveyard;Hello;Hello!;Hi;Hi!;Hello there!;* */* |c*|Hquest:*;Quest completed |c*;I have accepted |c*;Grinding;Moving away from group;Hello, I follow you!;Hello, lead the way!;Hi, lead the way!;Goodbye!;Bye bye!;See you later!;Fair trade;Off with you;A pleasure doing business with you;Thanks;I am ready for the next flight"
#
###############################################################################

#    PlayerbotsPlus.Mute.Enable
#        Default: 1
PlayerbotsPlus.Mute.Enable = 1

#    PlayerbotsPlus.Mute.Patterns
#        Default: "AI was reset to defaults;Using |c*;Drinking |c*;Eating |c*;Feasting |c*;I don't know this dungeon, lead the way!"
PlayerbotsPlus.Mute.Patterns = "AI was reset to defaults;Using |c*;Drinking |c*;Eating |c*;Feasting |c*;I don't know this dungeon, lead the way!"
