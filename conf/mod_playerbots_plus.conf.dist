PlayerbotsPlus.Hangout.Spot.DalaranMerchants = "571 5654.9 682.2 652.0 14 10 outside the Merchants' Bank in Dalaran"

#    PlayerbotsPlus.Hangout.CityWeights
#    PlayerbotsPlus.Hangout.Places
#    PlayerbotsPlus.Hangout.HotShare
#    PlayerbotsPlus.Hangout.HotSpots
#        How the room is shared out. With CityWeights on, Places are shared
#        among the cities by the weights playerbots sends its bots to the
#        cities' bankers by (Playerbots.TeleTo<City>Weight in playerbots.conf,
#        its defaults when that has none: Stormwind 5 and Ironforge 2 makes
#        Stormwind two and a half times as busy, and 0 means nobody there),
#        and in each city HotShare percent of its places are at its hot
#        spots (HotSpots: spot names, | separated -- each city's busiest
#        places: the Trade District, the Commons, the Valley of Strength, the
#        middle of Thunder Bluff, the banks and auction houses), the rest at
#        its other spots; a city with only one kind has all of them there.
#        Each spot gets its part of that by its capacity. Places 0: as many
#        as the spots' capacities add up to. Off: each spot has room for its
#        capacity. Either way .pbp status says how many are at the hot spots.
#        Default: 1, 0, 75, (below)
PlayerbotsPlus.Hangout.CityWeights = 1
PlayerbotsPlus.Hangout.Places = 0
PlayerbotsPlus.Hangout.HotShare = 75
PlayerbotsPlus.Hangout.HotSpots = "StormwindTrade|StormwindAuction|StormwindBank|IronforgeCommons|OrgrimmarValley|OrgrimmarBank|OrgrimmarCourtyard|OrgrimmarGateway|UndercityTrade|ThunderBluffMiddle|ThunderBluffBank|DarnassusBank|ExodarHall|SilvermoonExchange|ShattrathTerrace|DalaranBank|DalaranRuneweaver|DalaranMerchants"

#    PlayerbotsPlus.Hangout.RoomPerBot
#        Square yards each person at a spot needs: a spot with room for more
#        people than its radius holds grows to fit them (up to 60 yards).
#        Crowded, bots find nowhere to stand there. 0: radii as written.
#        Default: 60
PlayerbotsPlus.Hangout.RoomPerBot = 60

#    PlayerbotsPlus.Hangout.FullMinutes
#        A spot where a bot sent or fetched there finds nowhere to stand is
#        full: it takes nobody more, and the rest of its room goes to spots
#        that can take people -- its city's other spots of its kind (hot or
#        not) first, then its city's others, and when the whole city is full,
#        the other cities' spots, by their room. A bot fetched to a full spot
#        walks on to another spot in the city with room, if there is one. The
#        spot opens again as soon as fewer are there, or after this many
#        minutes. .pbp hangouts shows each spot: who is there, its room, and
#        why the places looked at for it were turned down -- for a spot
#        nobody can be put at (its middle in a wall, a fountain, a crowd).
#        1 to 120.
#        Default: 10
PlayerbotsPlus.Hangout.FullMinutes = 10

###############################################################################
#
#   STUCK ON A MOUNT
#
#   Playerbots' loot code gets a mounted bot down before it opens something.
#   When the opening then fails -- a mining vein another bot has hold of, a
#   herb two bots went for at once, a body it cannot get close to -- the
#   thing is put off for a second, then two, four, up to sixteen, and never
#   written off while the bot is near it. In that pause the mount check --
#   once a second, for a random bot with nothing to fight -- puts it back on
#   its mount, so the next try starts with another dismount: the bot gets on
#   and off on the spot, every few seconds, for as long as nothing gives. (A
#   try that only got the bot down does not count as a failed one.)
#
#   A bot that mounts MountCount times in WindowSeconds without leaving
#   Radius yards of where it started, out of any fight, takes the hint: what
#   it was trying to loot -- its loot target, else the gathering node it is
#   out for, else a chest-like object at its feet -- is out of its reach for
#   IgnoreMinutes (not its loot target, held off in its loot list, written
#   off as a gathering node), so it goes and does something else. A random
#   bot on its own also goes on foot for WalkMinutes, so it does not start
#   again at the next herb. Every one is logged at INFO with where it
#   happened, who the bot was with and anyone else at the same thing. One
#   with nothing to loot is only logged (and, if it is on its own, kept on
#   foot). With mod-ollama-chat, the bot knows it was stuck when someone
#   asks, and may laugh it off.
#
###############################################################################

#    PlayerbotsPlus.Stuck.Enable
#        Default: 1
PlayerbotsPlus.Stuck.Enable = 1

#    PlayerbotsPlus.Stuck.MountCount
#    PlayerbotsPlus.Stuck.WindowSeconds
#    PlayerbotsPlus.Stuck.Radius
#        A stuck bot goes round every two or three seconds at first (the
#        pauses in between grow later), so four times in half a minute
#        catches it early. A bot that was in a fight at any time since the
#        first of those mounts does not count: one grinding mobs that stand
#        close together kills one, loots it, gets on its mount and straight
#        off again for the next, on the spot but not stuck.
#        Default: 4, 30, 6
PlayerbotsPlus.Stuck.MountCount = 4
PlayerbotsPlus.Stuck.WindowSeconds = 30
PlayerbotsPlus.Stuck.Radius = 6

#    PlayerbotsPlus.Stuck.IgnoreMinutes
#        Default: 10
PlayerbotsPlus.Stuck.IgnoreMinutes = 10

#    PlayerbotsPlus.Stuck.WalkMinutes
#        How long a random bot on its own (no group, no master, not in a
#        battleground) that was caught at it stays on foot. Playerbots puts a
#        bot on its mount only while it has the "mount" strategy, so that is
#        taken off it, and given back when the time is up -- at once if it
#        joins a group or gets a master, or Stuck.Enable or the module is
#        switched off. On foot, the loot code's get-down-and-wait never
#        starts: it walks to the next herb and picks it, the way a player
#        would, and when the time is up it rides again. A bot in a group, or
#        with a master, keeps its mount so it keeps up. Nothing is saved:
#        a bot that logs out gets its strategies afresh when it logs in --
#        unless someone gives it a strategy command ("nc +..." / "co -...")
#        or an outfit command while it is on foot, when playerbots saves its
#        strategies as they are, and it would come back without its mount
#        until it is next randomised ("nc +mount" puts it right). 0 leaves
#        every bot its mount. At most 120.
#        Default: 10
PlayerbotsPlus.Stuck.WalkMinutes = 10

###############################################################################
#
#   ON FOOT INDOORS
#
#   The game lets nobody get on a mount under a roof, but it does not take
#   anyone off one who rides in, and playerbots' mount check does nothing at
#   all indoors, up or down. So a bot that rides into a bank or an inn -- or
#   is teleported to a banker on its mount -- stands at the counter on it for
#   as long as it is there.
#
#   Once a second, a bot that has been on a mount (or in a druid's travel or
#   flight form) indoors -- anywhere the game would not let it mount: a
#   building, a cave, a tunnel -- for Seconds gets off it the first time it
#   is standing still. Riding through a gateway or a tunnel without stopping
#   is left alone, as a player would ride through. Only a bot on the ground
#   in the open world, out of any fight, not on a flight path, a vehicle or a
#   boat; never a self-bot. A player's own bots stay up while their player is
#   on a mount close by (within 100 yards), and get off once the player has.
#   Outside again, playerbots puts them back on their mounts as it always
#   does. Bots hanging out in a city (City hangouts) only ever sit on a mount
#   at a place out in the open. With PlayerbotsPlus.Debug on, each one is
#   logged.
#
###############################################################################

#    PlayerbotsPlus.Indoors.Enable
#        Default: 1
PlayerbotsPlus.Indoors.Enable = 1

#    PlayerbotsPlus.Indoors.Seconds
#        How long a bot may be on its mount under a roof before it gets off,
#        the first time it is standing still after that. Short enough that
#        nobody sees one stand about on it; riding under an arch, or through
#        a tunnel without stopping, never takes anyone off. 1 to 60.
#        Default: 3
PlayerbotsPlus.Indoors.Seconds = 3

###############################################################################
#
#   OUT OF THE FIRE
#
#   A campfire, a bonfire or a brazier by a city's guards is a trap the game
#   fires at whoever stands in it: a few points of fire damage every few
#   seconds. Playerbots only steps out of one in a fight, and only for a bot
#   with a real player as its master, so a random bot that stops by a guard
#   to talk, or sits down to rest by a campfire, burns on the spot for as
#   long as it stays there.
#
#   A random bot burned by one -- out of any fight, not in a group, with no
#   real player as its master -- walks out of it: away from the middle,
#   Margin yards or so past its edge (as far as the game's own trap reaches,
#   or its spell's area if that is wider), onto ground it can walk to, in
#   sight, and not into the next fire. One hanging out at a city spot takes
#   that as its new place, and no hangout ever puts anyone in a fire. One
#   burned again within a minute is also sent off to do something else, so
#   it does not walk straight back to the guard it was talking to. With
#   PlayerbotsPlus.Debug on, each one is logged.
#
#   Most fires burn nobody -- Orgrimmar's bonfires are only something to cook
#   at -- and nobody stands in them all the same. Every couple of seconds a
#   bot standing still in a fire anyone can see is one, where a real player
#   could see it (Space.Range), walks out of it the same way: a cooking fire
#   (campfire, bonfire, brazier, stove), or something named like a fire, as
#   far as its model reaches at the size it is shown, with half a yard to
#   spare -- and a mount's length more for anyone riding one, whose mount's
#   head would be in the flames. Nothing puts anyone in one of those either,
#   and a hangout place leaves room for a mount.
#
#   .pbp fires (a GM, standing by one) lists the fires within 40 yards, how
#   near anyone may stand, and who is in one and why they stay.
#
###############################################################################

#    PlayerbotsPlus.Fire.Enable
#        Default: 1
PlayerbotsPlus.Fire.Enable = 1

#    PlayerbotsPlus.Fire.Margin
#        How far past the edge of a fire's reach (yards) a bot steps out to,
#        give or take a yard and a half. 0.5 to 5.
#        Default: 1.5
PlayerbotsPlus.Fire.Margin = 1.5

###############################################################################
#
#   ROOM TO STAND
#
#   Players who stop somewhere stand a step apart: nobody waits for the
#   innkeeper inside the next person, or inside the innkeeper. Playerbots
#   never minds where it stops. A bot sent to an innkeeper walks to the
#   innkeeper's own spot, a bot with nothing to do stands wherever it last
#   stopped, and a handful of them end up in one place, on top of each
#   other.
#
#   A random bot that has stood still for StillSeconds -- out of any fight,
#   not in a group, with no real player as its master, not casting, not on a
#   chair or bench -- closer than Distance yards to someone else who is
#   standing still (a player, or an NPC, a big one's own size added; pets,
#   companions and passers-by do not count) steps aside: StepMin to StepMax
#   yards away from them, onto ground it can walk to, on the same floor,
#   indoors or out the way it was, in sight, out of any fire and out of
#   everyone else's way, and turns back to face them. Of two bots on one
#   spot, the one that got there last moves. A bot hanging out at a city
#   spot takes the new place as its own and settles there as it was. One that
#   has just stepped aside does not again for CooldownSeconds, so nothing
#   pulling it back can make it shuffle on the spot. Only bots within Range
#   yards of a real player are looked at: crowding nobody sees is left
#   alone. With PlayerbotsPlus.Debug on, each step is logged.
#
###############################################################################

#    PlayerbotsPlus.Space.Enable
#        Default: 1
PlayerbotsPlus.Space.Enable = 1

#    PlayerbotsPlus.Space.Distance
#        Closer than this (yards, from middle to middle) is standing in
#        someone. 0.5 to 5.
#        Default: 1.75
PlayerbotsPlus.Space.Distance = 1.75

#    PlayerbotsPlus.Space.StillSeconds
#        How long a bot stands still before it notices. A bot that only
#        stops for a moment -- a word with a vendor, a look round -- is left
#        alone.
#        Default: 10
PlayerbotsPlus.Space.StillSeconds = 10

#    PlayerbotsPlus.Space.StepMin
#    PlayerbotsPlus.Space.StepMax
#        How far it steps (yards).
#        Default: 2.5, 5
PlayerbotsPlus.Space.StepMin = 2.5
PlayerbotsPlus.Space.StepMax = 5

#    PlayerbotsPlus.Space.CooldownSeconds
#    PlayerbotsPlus.Space.CheckSeconds
#    PlayerbotsPlus.Space.Range
#        How long before the same bot may step aside again; how often bots
#        are looked at (1 to 30 seconds); and how near a real player
#        (yards) a bot has to be to be looked at (0: anywhere).
#        Default: 60, 2, 120
PlayerbotsPlus.Space.CooldownSeconds = 60
PlayerbotsPlus.Space.CheckSeconds = 2
PlayerbotsPlus.Space.Range = 120

###############################################################################
#
#   GETTING BACK UP
#
#   Playerbots leaves a bot that dies near you lying where it fell until you
#   tell it what to do, and mod-dungeon-clear keeps every dungeon body for a
#   rez. People don't wait to be told: when nobody left standing in the
#   group can resurrect -- no living priest, paladin, shaman or druid who has
#   learned the spell -- a dead bot releases, runs back, gets up and joins
#   the fight again.
#
#     * Someone alive can rez: the bot waits for it, for up to
#       WaitForRezSeconds of nobody fighting, then gives up waiting.
#     * Nobody can: it releases after ReleaseDelaySeconds.
#     * Its body is in a dungeon or raid: the ghost runs from the graveyard
#       to the entrance and walks in, which brings it back there, as it does
#       for anyone. RunBackSeconds bounds the run when it cannot path there.
#       A raid that will not let anyone in during a boss fight is tried again
#       every few seconds.
#     * In the open world the ghost walks back to its body, as playerbots
#       already does.
#
#   Only bots in a group with a real player. Never in battlegrounds or arenas,
#   and not while a mod-dungeon-clear run is on: the run decides how its party
#   is brought back (a rez, a wait, or calling the run off), and once it has
#   called the run off, this takes over.
#
###############################################################################

#    PlayerbotsPlus.Revive.Enable
#        Default: 1
PlayerbotsPlus.Revive.Enable = 1

#    PlayerbotsPlus.Revive.ReleaseDelaySeconds
#        How long a bot nobody can rez lies there before it releases.
#        Default: 5
PlayerbotsPlus.Revive.ReleaseDelaySeconds = 5

#    PlayerbotsPlus.Revive.WaitForRezSeconds
#        How long a bot waits for a rez from someone who could give one,
#        counted only while nobody in the group is fighting. 0 waits for good.
#        Default: 60
PlayerbotsPlus.Revive.WaitForRezSeconds = 60

#    PlayerbotsPlus.Revive.RunBackSeconds
#        The longest a ghost spends running from the graveyard to its
#        dungeon before it walks in anyway (about as long as the run takes).
#        Default: 40
PlayerbotsPlus.Revive.RunBackSeconds = 40

###############################################################################
#
#   RAID MARKS
#
#   Marks make the plan plain without anyone barking it:
#
#       skull     kill first -- putting it on a mob starts the fight
#       cross     kill next -- it becomes the skull when the skull dies
#       moon      polymorph (mage)            star     sap (rogue)
#       diamond   banish or fear (warlock)    circle   shackle undead (priest)
#       triangle  hibernate, roots, cyclone (druid)
#       square    freezing trap (hunter)
#
#   Each bot whose class can crowd-control is told which mark is its to
#   control (ClassIcons), with playerbots' crowd-control strategy turned on
#   if it lacked it (priests and rogues do by default). Mark the pack, then
#   put the skull on the mob to kill first: nothing happens until the skull
#   goes on -- that is playerbots, the skull is every bot's target -- and as
#   the pack comes in, each one controls its own mark. A sap has to land
#   before the pull, so the star is the exception: put it on a mob that is
#   not fighting and a rogue in the group sneaks over and saps it. It goes
#   into stealth first -- with Stealth still on cooldown it keeps following
#   and goes when it can, rather than walking up in plain sight and pulling
#   -- comes round to the mob's back (a mob only spots stealth in front of
#   it), stops, turns to it and saps. A rogue that cannot -- no Sap before
#   level 10, a mob Sap does not work on (undead, elementals, machines...),
#   no stealth in time -- leaves the mob alone; with mod-ollama-chat it says
#   why in party.
#
#   Nothing here puts a mark on anything by default: the marks are the
#   players'. Two settings let the skull move on by itself when its mob dies,
#   while someone in the group is marking (a mark changed in the last
#   InUseSeconds that this did not make): onto the cross (CrossToSkull), and
#   failing that onto the nearest mob still fighting the group that nobody
#   marked to control (AutoSkull), so the bots finish the loose mobs before
#   they break anything that is controlled. Either only ever moves it onto a
#   mob already in the fight: a cross on the next pack waits for its own
#   skull. Groups that do not mark see none of this.
#
#   In a 5-man dungeon playerbots' bots only crowd-control what is marked
#   for them; in raids and out in the world they also pick targets of their
#   own.
#
###############################################################################

#    PlayerbotsPlus.Marks.Enable
#        Default: 1
PlayerbotsPlus.Marks.Enable = 1

#    PlayerbotsPlus.Marks.ClassIcons
#        class:mark pairs, comma separated. Classes: warrior, paladin,
#        hunter, rogue, priest, deathknight, shaman, mage, warlock, druid.
#        Marks: star, circle, diamond, triangle, moon, square, cross, skull.
#        A paladin given a mark turns undead on it; shamans have no crowd
#        control in playerbots.
#        Default: "mage:moon, rogue:star, priest:circle, warlock:diamond, druid:triangle, hunter:square"
PlayerbotsPlus.Marks.ClassIcons = "mage:moon, rogue:star, priest:circle, warlock:diamond, druid:triangle, hunter:square"

#    PlayerbotsPlus.Marks.AddCcStrategy
#        Turn playerbots' crowd-control strategy on for those classes when a
#        bot lacks it -- never for a tank, which would drop out of bear form
#        to do it.
#        Default: 1
PlayerbotsPlus.Marks.AddCcStrategy = 1

#    PlayerbotsPlus.Marks.SapStar
#        A rogue bot saps the mob the star is put on, when nothing is fighting.
#        Default: 1
PlayerbotsPlus.Marks.SapStar = 1

#    PlayerbotsPlus.Marks.CrossToSkull
#    PlayerbotsPlus.Marks.AutoSkull
#        When the skull's mob dies, the skull moves onto the cross's
#        (CrossToSkull) or, with no cross in the fight, onto the next loose
#        mob in it (AutoSkull). The players' own marks get moved, so both are
#        off by default.
#        Default: 0, 0
PlayerbotsPlus.Marks.CrossToSkull = 0
PlayerbotsPlus.Marks.AutoSkull = 0

#    PlayerbotsPlus.Marks.InUseSeconds
#        With CrossToSkull or AutoSkull on: how long after someone last
#        changed a mark the skull keeps moving on by itself.
#        Default: 180
PlayerbotsPlus.Marks.InUseSeconds = 180

#    PlayerbotsPlus.Marks.SapStealthWaitSeconds
#    PlayerbotsPlus.Marks.SapApproachSeconds
#    PlayerbotsPlus.Marks.SapWaitSeconds
#        How long the rogue waits to go into stealth (Stealth cools down for
#        10 seconds after it breaks), and then how long it may take to sneak
#        round the mob and sap it, before it gives up -- not counting up to
#        SapWaitSeconds spent hanging back, out of sight, while a mob that
#        wanders about is on the move.
#
#        How close it may come in front is worked out the way the core does
#        it (the mob's level against the rogue's stealth): where its Sap
#        reaches further than that, it goes straight in; otherwise round the
#        side, out of sight, and in from behind, the side a mob never spots
#        stealth from. Every sap's outcome is logged at INFO, with the
#        distances, whatever PlayerbotsPlus.Debug says.
#        Default: 12, 40, 20
PlayerbotsPlus.Marks.SapStealthWaitSeconds = 12
PlayerbotsPlus.Marks.SapApproachSeconds = 40
PlayerbotsPlus.Marks.SapWaitSeconds = 20

###############################################################################
#
#   HUNTERS' PETS AND COMPANIONS
#
#   Playerbots tames a beast for a hunter and leaves it called what it is
#   ("Boar", "Wind Serpent"). Players rename theirs, mostly after something
#   they love or for a laugh: a cat called Aslan, a boar called Porkchop, a
#   worm called Graboid. And most players carry a companion or two and have one
#   trotting along: a cat from the pet seller in Elwynn, a snake from
#   Orgrimmar, a parrot from Booty Bay, something rare that took a week to
#   drop. With mod-ollama-chat, a bot knows what its pet is called and what is
#   following it, and talks about it when someone does.
#
###############################################################################

#    PlayerbotsPlus.Pets.NamesEnable
#    PlayerbotsPlus.Pets.NameChance
#    PlayerbotsPlus.Pets.NamesPerMinute
#        A random bot's hunter whose pet still has the name it was tamed
#        with gives it one, the way the game does when a player renames a pet:
#        the same checks (reserved and rude names are refused), its one
#        rename, the name saved. NameChance of them do; the rest are the
#        kind who never bother. NamesPerMinute caps it, the realm over, so a
#        fresh start does not rename everyone at once. Your own bots' pets
#        are left alone.
#        Default: 1, 85, 20
PlayerbotsPlus.Pets.NamesEnable = 1
PlayerbotsPlus.Pets.NameChance = 85
PlayerbotsPlus.Pets.NamesPerMinute = 20

#    PlayerbotsPlus.Pets.Names.<Family>
#        The names, separated by |: 2 to 12 letters, nothing else (no
#        spaces), written however you like ("Graboid", "graboid": the game
#        keeps the first letter capital). A pet mostly gets one of its own
#        family's and now and then one of Any. Families: Wolf, Cat, Spider,
#        Bear, Boar, Crocolisk, CarrionBird, Crab, Gorilla, Raptor,
#        Tallstrider, Scorpid, Turtle, Bat, Hyena, Owl, WindSerpent,
#        Dragonhawk, Ravager, WarpStalker, Sporebat, NetherRay, Serpent,
#        Moth, Chimaera, Devilsaur, Silithid, Worm, Rhino, Wasp, CoreHound,
#        SpiritBeast. With no Names keys at all, these are the defaults.
